import MVFBSDEJ.PaperSpec.Setting
import MVFBSDEJ.WellPosedness.Spec.BrownianForms

/-!
# Example 5.2 of the well-posedness paper: the reduction to the Brownian forms

Statement numbers refer to the well-posedness paper at `1f67672`, in the standing setting of §2 with
the intensity `ν = 0`. Example 5.2 removes the Poisson channel, so that the filtration is generated
by `W` and `ℱ₀`, deletes the `U`-coordinate, and states that the assumptions reduce to
`W₂`-Lipschitz dependence on the joint law of `(X, Y, Z)` under `G`-monotonicity. The Brownian forms
of Assumptions 2.3 and 2.5 and of the solution notions are those of
`MVFBSDEJ.WellPosedness.Spec.BrownianForms`, over the usual augmentation of the filtration
generated by `W` and `ℱ₀`.

## Main definitions

* `MVFBSDEJ.PaperSpec.BrownianSolution`, `BrownianWeakSolution` — `(X, Y, Z)` solves the
  Brownian forward–backward system in `𝕊`, resp. in `ℍ²`, over the filtration generated by
  `W` and `ℱ₀`.
* `MVFBSDEJ.PaperSpec.RepresentsMartBrownian` — a predictable `Z` represents a martingale as
  `M_0 + ∫ Z dW` over the filtration generated by `W` and `ℱ₀`.
* `MVFBSDEJ.PaperSpec.ex_brownian_reduction` — at `ν = 0`, Assumptions 2.3 and 2.5, (2.7)
  and the solution notions of (1.1) are their Brownian forms.
* `MVFBSDEJ.PaperSpec.ex_brownian_prp` — at `ν = 0`, the representation property is the
  Brownian one.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped Topology ENNReal

namespace MVFBSDEJ.PaperSpec

open MVFBSDEJ.WellPosedness.System MVFBSDEJ.WellPosedness.Enlarged
  MVFBSDEJ.WellPosedness.Existence MVFBSDEJ.WellPosedness.Spec

universe u v w

section Solutions

variable {Ω : Type u} {𝒢₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {E : Type v}
  [MeasurableSpace E] [MeasurableSpace.CountablyGenerated E] {n m d : ℕ} {P : Measure Ω}
  [IsProbabilityMeasure P]

/-- `(X, Y, Z)` satisfies the Brownian forward–backward system with coefficients `C` at `ν = 0`
and initial datum `ξ₀` in `ℍ²`, over the usual augmentation of the filtration generated by
the Brownian motion `W` and `𝒢₀`: `BrownianPaperWeakSolution` there, with every path of `X` and
of `Y` having left limits on `(0, T]`. -/
def BrownianWeakSolution (W : LevyStochCalc.Brownian.Multidim.MultidimBrownianMotion P d)
    (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hW : ∀ j, LevyStochCalc.Brownian.IsBrownianFiltration (W.W j) (enlBrownian 𝒢₀ W h𝒢₀))
    (T : ℝ) (C : Coeffs (0 : Measure E) n m d) (ξ₀ : Ω → EuclideanSpace ℝ (Fin n))
    (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ) (Z : Fin m → ℝ → Ω → Fin d → ℝ) : Prop :=
  BrownianPaperWeakSolution W (enlBrownian 𝒢₀ W h𝒢₀) hW T C (fun i ω => ξ₀ ω i) X Y Z
    ∧ (∀ i ω, ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ l : ℝ, Tendsto (fun s => X i s ω) (𝓝[<] t) (𝓝 l))
    ∧ ∀ k ω, ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ l : ℝ, Tendsto (fun s => Y k s ω) (𝓝[<] t) (𝓝 l)

/-- `(X, Y, Z)` solves the Brownian forward–backward system with coefficients `C` at `ν = 0` and
initial datum `ξ₀` in `𝕊`, over the usual augmentation of the filtration generated by the
Brownian motion `W` and `𝒢₀`: `(X, Y, Z)` satisfies it in `ℍ²` (`BrownianWeakSolution`), and
`𝔼 sup_{t ≤ T} |X_t|² < ∞`, `𝔼 sup_{t ≤ T} |Y_t|² < ∞`. -/
def BrownianSolution (W : LevyStochCalc.Brownian.Multidim.MultidimBrownianMotion P d)
    (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hW : ∀ j, LevyStochCalc.Brownian.IsBrownianFiltration (W.W j) (enlBrownian 𝒢₀ W h𝒢₀))
    (T : ℝ) (C : Coeffs (0 : Measure E) n m d) (ξ₀ : Ω → EuclideanSpace ℝ (Fin n))
    (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ) (Z : Fin m → ℝ → Ω → Fin d → ℝ) : Prop :=
  BrownianWeakSolution W h𝒢₀ hW T C ξ₀ X Y Z
    ∧ ∫⁻ ω, (⨆ t ∈ Set.Icc (0 : ℝ) T,
        MVFBSDEJ.WellPosedness.Stability.esq (fun i => X i t ω)) ∂P < ⊤
    ∧ ∫⁻ ω, (⨆ t ∈ Set.Icc (0 : ℝ) T,
        MVFBSDEJ.WellPosedness.Stability.esq (fun k => Y k t ω)) ∂P < ⊤

open LevyStochCalc in
/-- `Z` represents `M` on `[0, T]` over the usual augmentation of the filtration generated by the
Brownian motion `W` and `𝒢₀`: `Z` is predictable with finite energy and vanishes off `[0, T]`,
and for every `t ∈ [0, T]`, almost surely `M_t = M_0 + ∫_0^t Z_s dW_s`. -/
def RepresentsMartBrownian (W : LevyStochCalc.Brownian.Multidim.MultidimBrownianMotion P d)
    (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hW : ∀ j, LevyStochCalc.Brownian.IsBrownianFiltration (W.W j) (enlBrownian 𝒢₀ W h𝒢₀))
    (T : ℝ) (M : ℝ → Ω → ℝ) (Z : ℝ → Ω → Fin d → ℝ) : Prop :=
  ∃ (hZ : ∀ j, Probability.Predictable (enlBrownian 𝒢₀ W h𝒢₀) fun ω s => Z s ω j)
    (hZv : ∀ ω s, s ∉ Set.Icc (0 : ℝ) T → Z s ω = 0)
    (hZe : ∀ j, Brownian.Ito.energy P T (fun ω s => Z s ω j) ≠ ⊤),
    ∀ t ∈ Set.Icc (0 : ℝ) T, M t =ᵐ[P] fun ω => M 0 ω
      + Brownian.Multidim.MultidimBrownianMotion.stochasticIntegral W (enlBrownian 𝒢₀ W h𝒢₀) hW
          Z (fun j => Brownian.Ito.measurable_uncurry_of_predictable (hZ j))
          (progressivelyMeasurable_of_predictable_of_vanish hZ hZv)
          (BSDEJ.Solves.sq_int_global_of_vanishing hZv hZe) t ω

end Solutions

/-- Example 5.2 (Brownian reduction), the assumptions and the solution notions. In the standing
setting with the intensity `ν = 0`, for all dimensions `n, m`, every horizon `T` and every
coefficient system `C`, with `ℱ^B` the usual augmentation of the filtration generated by `W` and
`ℱ₀`:
(a) Assumption 2.3 with a constant `L` holds if and only if `L ≥ 0` and, over `ℱ^B`,
`|δb| + |δσ|_F + |δf| ≤ L (|δX| + |δY| + |δZ|_F + W₂(μ^{XYZ}, μ'^{XYZ}))` along the diagonal for
almost every `t ∈ [0, T]` and (2.6) hold, `μ^{XYZ}` the law of `(X, Y, Z)`; and at each time the
interior bound of Assumption 2.3 is this bound;
(b) at each time (2.7) is, over `ℱ^B`, the inequality
`𝔼[⟨δb, Gᵀ δY⟩ + ⟨δσ, Gᵀ δZ⟩_F + ⟨−δf, G δX⟩] ≤ −β₁ 𝔼[|Gᵀ δY|² + |Gᵀ δZ|²_F] − β₂ 𝔼|G δX|²`,
and Assumption 2.5 holds if and only if this `G`-monotonicity, the terminal inequality and the
admissible constants hold over `ℱ^B`;
(c) `(X, Y, Z, U)` solves (1.1) in `𝕊`, resp. satisfies it in `ℍ²`, if and only if `U` is a
predictable integrand vanishing off `[0, T]`, which is `0` in `L²(dt ⊗ dP ⊗ ν)`, and `(X, Y, Z)`
solves the Brownian forward–backward system
`X_t = ξ₀ + ∫_0^t b(s, Θ_s, μ_s) ds + ∫_0^t σ(s, Θ_s, μ_s) dW_s`,
`Y_t = g(X_T, Law X_T) + ∫_t^T f(s, Θ_s, μ_s) ds − ∫_t^T Z_s dW_s` over `ℱ^B` in `𝕊`, resp. in
`ℍ²`. -/
def ex_brownian_reduction : Prop :=
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] [MeasurableSpace.CountablyGenerated E] (d : ℕ)
    (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d (0 : Measure E)) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (n m : ℕ) (T : ℝ)
    (C : Coeffs (0 : Measure E) n m d),
    (∀ L : ℝ, Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L C
        ↔ BrownianAssumption23 (enlBrownian 𝒢₀ D.W h𝒢₀) P T L C)
    ∧ (∀ t L : ℝ, LipInteriorAt (enlJoint 𝒢₀ D h𝒢₀) P t L C
        ↔ BrownianLipInteriorAt (enlBrownian 𝒢₀ D.W h𝒢₀) P t L C)
    ∧ (∀ (t : ℝ) (G : Matrix (Fin m) (Fin n) ℝ) (β₁ β₂ : ℝ),
        Mono27At (enlJoint 𝒢₀ D h𝒢₀) P t G β₁ β₂ C
          ↔ BrownianMonoAt (enlBrownian 𝒢₀ D.W h𝒢₀) P t G β₁ β₂ C)
    ∧ (∀ (G : Matrix (Fin m) (Fin n) ℝ) (α β₁ β₂ : ℝ),
        Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ C
          ↔ BrownianAssumption25 (enlBrownian 𝒢₀ D.W h𝒢₀) P T G α β₁ β₂ C)
    ∧ (∀ (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ)
        (Z : Fin m → ℝ → Ω → Fin d → ℝ) (U : Fin m → ℝ → Ω → E → ℝ),
        Solution D h𝒢₀ hind₀ T C ξ₀ X Y Z U
          ↔ (∀ k, LevyStochCalc.Probability.MarkedPredictable (enlBrownian 𝒢₀ D.W h𝒢₀)
                (0 : Measure E) (fun ω s e => U k s ω e)
              ∧ (∀ ω s e, s ∉ Set.Icc (0 : ℝ) T → U k s ω e = 0)
              ∧ LevyStochCalc.Poisson.Compensated.markedEnergy P (0 : Measure E) T
                (fun ω s e => U k s ω e) = 0)
            ∧ BrownianSolution D.W h𝒢₀ (isBrownianFiltration_enlBrownian D h𝒢₀ hind₀) T C ξ₀
              X Y Z)
    ∧ ∀ (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ)
        (Z : Fin m → ℝ → Ω → Fin d → ℝ) (U : Fin m → ℝ → Ω → E → ℝ),
        WeakSolution D h𝒢₀ hind₀ T C ξ₀ X Y Z U
          ↔ (∀ k, LevyStochCalc.Probability.MarkedPredictable (enlBrownian 𝒢₀ D.W h𝒢₀)
                (0 : Measure E) (fun ω s e => U k s ω e)
              ∧ (∀ ω s e, s ∉ Set.Icc (0 : ℝ) T → U k s ω e = 0)
              ∧ LevyStochCalc.Poisson.Compensated.markedEnergy P (0 : Measure E) T
                (fun ω s e => U k s ω e) = 0)
            ∧ BrownianWeakSolution D.W h𝒢₀ (isBrownianFiltration_enlBrownian D h𝒢₀ hind₀) T C
              ξ₀ X Y Z

/-- Example 5.2 (Brownian reduction), the representation property. In the standing setting with
the intensity `ν = 0`, for `d ≥ 1` and `T > 0`, every square-integrable martingale `M` of the
usual augmentation of the filtration generated by `W` and `ℱ₀` is represented on `[0, T]` as
`M_t = M_0 + ∫_0^t Z_s dW_s` by a predictable square-integrable `Z`, and any two representing `Z`
agree up to null sets (the energies of their differences vanish): the Brownian representation
property. -/
def ex_brownian_prp : Prop :=
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] [MeasurableSpace.CountablyGenerated E] (d : ℕ)
    (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d (0 : Measure E)) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P), 0 < d → ∀ T : ℝ, 0 < T →
    ∀ M : ℝ → Ω → ℝ, Martingale M (enlBrownian 𝒢₀ D.W h𝒢₀) P → (∀ t, MemLp (M t) 2 P) →
      (∃ Z : ℝ → Ω → Fin d → ℝ,
        RepresentsMartBrownian D.W h𝒢₀ (isBrownianFiltration_enlBrownian D h𝒢₀ hind₀) T M Z)
      ∧ ∀ Z Z' : ℝ → Ω → Fin d → ℝ,
        RepresentsMartBrownian D.W h𝒢₀ (isBrownianFiltration_enlBrownian D h𝒢₀ hind₀) T M Z →
        RepresentsMartBrownian D.W h𝒢₀ (isBrownianFiltration_enlBrownian D h𝒢₀ hind₀) T M Z' →
        ∀ j, LevyStochCalc.Brownian.Ito.energy P T (fun ω s => Z s ω j - Z' s ω j) = 0

end MVFBSDEJ.PaperSpec
