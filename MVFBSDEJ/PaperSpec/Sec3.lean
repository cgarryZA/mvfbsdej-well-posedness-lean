import MVFBSDEJ.PaperSpec.Setting
import MVFBSDEJ.WellPosedness.Spec.Cor36Law

/-!
# Section 3 of the well-posedness paper: the main results

Statement and equation numbers refer to the well-posedness paper at `1f67672`. The standing
setting of §2: a probability space carrying a `d`-dimensional Brownian motion `W` and an
independent Poisson random measure `N` with intensity `dt ν(de)`, `ν` σ-finite on a countably
generated `(E, ℰ)`, the filtration the usual augmentation of the one generated by `W`, `N` and an
independent initial σ-field `ℱ₀`, a horizon `T > 0` and dimensions `n, m, d ≥ 1`.

## Main definitions

* `MVFBSDEJ.PaperSpec.thm_stab` — Theorem 3.1.
* `MVFBSDEJ.PaperSpec.thm_uniq` — Theorem 3.3.
* `MVFBSDEJ.PaperSpec.thm_cwp` — Theorem 3.5, existence and uniqueness; its continuous
  dependence in the sense of (3.1) is Theorem 3.1.
* `MVFBSDEJ.PaperSpec.cor_robust`, `cor_robust_wp`, `cor_robust_lip` — Corollary 3.6: the
  assumptions of the perturbed system, its well-posedness, and (3.5) giving (3.4).
* `MVFBSDEJ.PaperSpec.prop_strict` — Proposition 3.8.
-/

open MeasureTheory Filter ProbabilityTheory
open scoped ENNReal

namespace MVFBSDEJ.PaperSpec

open MVFBSDEJ.WellPosedness.System MVFBSDEJ.WellPosedness.Existence
  MVFBSDEJ.WellPosedness.Enlarged MVFBSDEJ.WellPosedness.Stability
  MVFBSDEJ.WellPosedness.Spec

universe u v w

/-- Theorem 3.1 (stability under coefficient and data perturbation). There is a function
`C_stab` of `(T, L, ‖G‖, c_G, α, β₁, β₂)` such that: in the standing setting, if system `1` with
initial datum `ξ¹` satisfies (2.3) and Assumptions 2.2–2.5 with constants `L, α, β₁, β₂` and
coupling matrix `G` (`‖G‖` its operator norm, `c_G = s_min(G)⁻²`), system `2` with initial datum
`ξ²` satisfies (2.3) and Assumptions 2.2–2.3 with its own constant `L₂`, and `Θᵏ` solves (1.1)
for system `k`, then

`𝔼 sup_{t ≤ T} |δX_t|² + 𝔼 sup_{t ≤ T} |δY_t|² + 𝔼 ∫_0^T (|δZ_t|²_F + ‖δU_t‖²)
  ≤ C_stab (𝔼|δξ₀|² + 𝔼|δ̂g_T|² + 𝔼 ∫_0^T (|δb|² + |δσ|²_F + ‖δh‖² + |δf|²))`,

with `δψ = ψ¹(t, Θ²_t, μ²_t) − ψ²(t, Θ²_t, μ²_t)` for `ψ ∈ {b, σ, f}`,
`δh = h¹(t, Θ²⁻_t, ·, μ²⁻_t) − h²(t, Θ²⁻_t, ·, μ²⁻_t)` and
`δ̂g_T = g¹(X²_T, Law X²_T) − g²(X²_T, Law X²_T)`. The inequality is read in `[0, ∞]`. -/
def thm_stab : Prop :=
  ∃ Cstab : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ,
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] (ν : Measure E) [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
    (n m d : ℕ) (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P),
    0 < n → 0 < m → 0 < d → ∀ T : ℝ, 0 < T →
    ∀ (L L₂ α β₁ β₂ : ℝ) (G : Matrix (Fin m) (Fin n) ℝ) (C₁ C₂ : Coeffs ν n m d)
      (ξ₁ ξ₂ : Ω → EuclideanSpace ℝ (Fin n)),
    JointBorel T C₁ → Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T C₁ ξ₁ →
    Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L C₁ → G.rank = min m n →
    Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ C₁ →
    JointBorel T C₂ → Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T C₂ ξ₂ →
    Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L₂ C₂ →
    ∀ (X₁ X₂ : Fin n → ℝ → Ω → ℝ) (Y₁ Y₂ : Fin m → ℝ → Ω → ℝ)
      (Z₁ Z₂ : Fin m → ℝ → Ω → Fin d → ℝ) (U₁ U₂ : Fin m → ℝ → Ω → E → ℝ),
    Solution D h𝒢₀ hind₀ T C₁ ξ₁ X₁ Y₁ Z₁ U₁ → Solution D h𝒢₀ hind₀ T C₂ ξ₂ X₂ Y₂ Z₂ U₂ →
    supSize P ν T (fun i t ω => X₁ i t ω - X₂ i t ω) (fun k t ω => Y₁ k t ω - Y₂ k t ω)
        (fun k t ω j => Z₁ k t ω j - Z₂ k t ω j) (fun k t ω e => U₁ k t ω e - U₂ k t ω e)
      ≤ ENNReal.ofReal (Cstab T L ‖GX G‖ (sMin G ^ 2)⁻¹ α β₁ β₂)
        * dataSize P ν T (fun i ω => ξ₁ ω i - ξ₂ ω i)
          (fun i ω s => driftProc P T C₁ X₂ Y₂ Z₂ U₂ i ω s
            - driftProc P T C₂ X₂ Y₂ Z₂ U₂ i ω s)
          (fun i s ω j => diffusionProc P T C₁ X₂ Y₂ Z₂ U₂ i s ω j
            - diffusionProc P T C₂ X₂ Y₂ Z₂ U₂ i s ω j)
          (fun i s ω e =>
            jumpProc T (coeffJump P T C₁ (leftLimProc X₂) (leftLimProc Y₂) Z₂ U₂) i s ω e
              - jumpProc T (coeffJump P T C₂ (leftLimProc X₂) (leftLimProc Y₂) Z₂ U₂) i s ω e)
          (fun k ω s => driverProc P T C₁ X₂ Y₂ Z₂ U₂ k ω s
            - driverProc P T C₂ X₂ Y₂ Z₂ U₂ k ω s)
          (fun k ω => terminalVal P T C₁ X₂ k ω - terminalVal P T C₂ X₂ k ω)

/-- Theorem 3.3 (uniqueness). In the standing setting, for every horizon `T > 0`, if the
coefficients satisfy (2.3) and Assumptions 2.3–2.5 with constants `L, α, β₁, β₂` and coupling
matrix `G`, and `Θ¹, Θ² ∈ ℍ²` satisfy (1.1) with the same initial datum `ξ₀`, then
`Θ¹ = Θ²` in `ℍ²`: their `X` and their `Y` are indistinguishable on `[0, T]`, and
`𝔼 ∫_0^T |Z¹_t − Z²_t|²_F dt = 0` and `𝔼 ∫_0^T ‖U¹_t − U²_t‖²_{L²(ν)} dt = 0`, coordinatewise;
furthermore `Θ¹ − Θ² ∈ 𝕊`: `‖Θ¹ − Θ²‖²_𝕊 < ∞`. -/
def thm_uniq : Prop :=
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] (ν : Measure E) [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
    (n m d : ℕ) (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P),
    0 < n → 0 < m → 0 < d → ∀ T : ℝ, 0 < T →
    ∀ (L α β₁ β₂ : ℝ) (G : Matrix (Fin m) (Fin n) ℝ) (C : Coeffs ν n m d),
    JointBorel T C → Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L C → G.rank = min m n →
    Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ C →
    ∀ (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (X₁ X₂ : Fin n → ℝ → Ω → ℝ)
      (Y₁ Y₂ : Fin m → ℝ → Ω → ℝ) (Z₁ Z₂ : Fin m → ℝ → Ω → Fin d → ℝ)
      (U₁ U₂ : Fin m → ℝ → Ω → E → ℝ),
    WeakSolution D h𝒢₀ hind₀ T C ξ₀ X₁ Y₁ Z₁ U₁ → WeakSolution D h𝒢₀ hind₀ T C ξ₀ X₂ Y₂ Z₂ U₂ →
    ((∀ i, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, X₁ i t ω = X₂ i t ω)
      ∧ (∀ k, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, Y₁ k t ω = Y₂ k t ω)
      ∧ (∀ k j, LevyStochCalc.Brownian.Ito.energy P T
          (fun ω s => Z₁ k s ω j - Z₂ k s ω j) = 0)
      ∧ ∀ k, LevyStochCalc.Poisson.Compensated.markedEnergy P ν T
          (fun ω s e => U₁ k s ω e - U₂ k s ω e) = 0)
    ∧ supSize P ν T (fun i t ω => X₁ i t ω - X₂ i t ω) (fun k t ω => Y₁ k t ω - Y₂ k t ω)
        (fun k t ω j => Z₁ k t ω j - Z₂ k t ω j) (fun k t ω e => U₁ k t ω e - U₂ k t ω e) < ⊤

/-- Theorem 3.5 (global well-posedness), existence and uniqueness. In the standing setting, for
every horizon `T > 0`, if the coefficients with initial datum `ξ₀` satisfy (2.3) and
Assumptions 2.2–2.5 with constants `L, α, β₁, β₂` and coupling matrix `G`, then (1.1) has a
solution `Θ = (X, Y, Z, U)` in `𝕊`, and any two solutions are equal in `𝕊`: their `X` and their
`Y` are indistinguishable on `[0, T]`, and `𝔼 ∫_0^T |Z¹_t − Z²_t|²_F dt = 0` and
`𝔼 ∫_0^T ‖U¹_t − U²_t‖²_{L²(ν)} dt = 0`, coordinatewise. -/
def thm_cwp : Prop :=
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] (ν : Measure E) [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
    (n m d : ℕ) (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P),
    0 < n → 0 < m → 0 < d → ∀ T : ℝ, 0 < T →
    ∀ (L α β₁ β₂ : ℝ) (G : Matrix (Fin m) (Fin n) ℝ) (C : Coeffs ν n m d)
      (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)),
    JointBorel T C → Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T C ξ₀ →
    Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L C → G.rank = min m n →
    Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ C →
    (∃ (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ) (Z : Fin m → ℝ → Ω → Fin d → ℝ)
      (U : Fin m → ℝ → Ω → E → ℝ), Solution D h𝒢₀ hind₀ T C ξ₀ X Y Z U)
    ∧ ∀ (X₁ X₂ : Fin n → ℝ → Ω → ℝ) (Y₁ Y₂ : Fin m → ℝ → Ω → ℝ)
      (Z₁ Z₂ : Fin m → ℝ → Ω → Fin d → ℝ) (U₁ U₂ : Fin m → ℝ → Ω → E → ℝ),
      Solution D h𝒢₀ hind₀ T C ξ₀ X₁ Y₁ Z₁ U₁ → Solution D h𝒢₀ hind₀ T C ξ₀ X₂ Y₂ Z₂ U₂ →
      (∀ i, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, X₁ i t ω = X₂ i t ω)
        ∧ (∀ k, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, Y₁ k t ω = Y₂ k t ω)
        ∧ (∀ k j, LevyStochCalc.Brownian.Ito.energy P T
            (fun ω s => Z₁ k s ω j - Z₂ k s ω j) = 0)
        ∧ ∀ k, LevyStochCalc.Poisson.Compensated.markedEnergy P ν T
            (fun ω s e => U₁ k s ω e - U₂ k s ω e) = 0

/-- Corollary 3.6 (robustness of well-posedness), the assumptions of the perturbed system. In the
standing setting with `m = n`, for every horizon `T > 0`, let the baseline system `C` with
initial datum `ξ₀` satisfy (2.3) and Assumptions 2.2–2.5 with constants `L₀, α, β₁, β₂` and
coupling matrix `G`, and the unweighted margin (2.13) with `c_diss > 0`; let the perturbation `p`
satisfy the origin values of Assumption 2.2, the interior bound of Assumption 2.3 with a constant
`L_p ≥ 0`, and (3.4) with a constant `c_pert ≥ 0`; let the perturbed system
`(b₀ + p_b, σ₀ + p_σ, h₀ + p_h, f₀ + p_f, g)` satisfy (2.3); and let `c_pert < c_diss`. Then the
perturbed system with initial datum `ξ₀` satisfies Assumptions 2.2–2.5 with the same
`G, α, β₁, β₂` and some Lipschitz constant, and (2.13) with the margin `c_diss − c_pert`. -/
def cor_robust : Prop :=
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] (ν : Measure E) [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
    (n d : ℕ) (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (_ : Indep 𝒢₀ (⨆ t, D.filtration t) P),
    0 < n → 0 < d → ∀ T : ℝ, 0 < T →
    ∀ (L₀ Lₚ α β₁ β₂ cdiss cpert : ℝ) (G : Matrix (Fin n) (Fin n) ℝ) (C p : Coeffs ν n n d)
      (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)),
    JointBorel T C → Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T C ξ₀ →
    Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L₀ C → G.rank = min n n →
    Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ C →
    Margin213 (enlJoint 𝒢₀ D h𝒢₀) P T G β₁ β₂ cdiss C → 0 < cdiss →
    OriginValues T p → LipInterior (enlJoint 𝒢₀ D h𝒢₀) P T Lₚ p → 0 ≤ Lₚ →
    PairingBound34 (enlJoint 𝒢₀ D h𝒢₀) P T G cpert p → 0 ≤ cpert →
    JointBorel T (C.perturb p) → cpert < cdiss →
    Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T (C.perturb p) ξ₀
      ∧ (∃ L : ℝ, Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L (C.perturb p)) ∧ G.rank = min n n
      ∧ Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ (C.perturb p)
      ∧ Margin213 (enlJoint 𝒢₀ D h𝒢₀) P T G β₁ β₂ (cdiss - cpert) (C.perturb p)

/-- Corollary 3.6, well-posedness of the perturbed system. There is a function `C_stab` of
`(T, L, ‖G‖, c_G, α, β₁, β₂)` such that: under the hypotheses of `cor_robust`, the perturbed
system with initial datum `ξ₀` has a solution in `𝕊`; any two tuples of `ℍ²` satisfying it
with the same initial datum are equal in `ℍ²`; and for every constant `L` with which the
perturbed system satisfies Assumption 2.3, (3.1) holds with the constant
`C_stab(T, L, ‖G‖, s_min(G)⁻², α, β₁, β₂)` for its solutions against the solutions of every
system `2` satisfying (2.3) and Assumptions 2.2–2.3. -/
def cor_robust_wp : Prop :=
  ∃ Cstab : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ,
  ∀ {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) [mΩ : MeasurableSpace Ω] {E : Type v}
    [MeasurableSpace E] (ν : Measure E) [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
    (n d : ℕ) (P : Measure Ω) [IsProbabilityMeasure P]
    (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P),
    0 < n → 0 < d → ∀ T : ℝ, 0 < T →
    ∀ (L₀ Lₚ α β₁ β₂ cdiss cpert : ℝ) (G : Matrix (Fin n) (Fin n) ℝ) (C p : Coeffs ν n n d)
      (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)),
    JointBorel T C → Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T C ξ₀ →
    Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L₀ C → G.rank = min n n →
    Assumption25 (enlJoint 𝒢₀ D h𝒢₀) P T G α β₁ β₂ C →
    Margin213 (enlJoint 𝒢₀ D h𝒢₀) P T G β₁ β₂ cdiss C → 0 < cdiss →
    OriginValues T p → LipInterior (enlJoint 𝒢₀ D h𝒢₀) P T Lₚ p → 0 ≤ Lₚ →
    PairingBound34 (enlJoint 𝒢₀ D h𝒢₀) P T G cpert p → 0 ≤ cpert →
    JointBorel T (C.perturb p) → cpert < cdiss →
    (∃ (X : Fin n → ℝ → Ω → ℝ) (Y : Fin n → ℝ → Ω → ℝ) (Z : Fin n → ℝ → Ω → Fin d → ℝ)
      (U : Fin n → ℝ → Ω → E → ℝ), Solution D h𝒢₀ hind₀ T (C.perturb p) ξ₀ X Y Z U)
    ∧ (∀ (X₁ X₂ : Fin n → ℝ → Ω → ℝ) (Y₁ Y₂ : Fin n → ℝ → Ω → ℝ)
        (Z₁ Z₂ : Fin n → ℝ → Ω → Fin d → ℝ) (U₁ U₂ : Fin n → ℝ → Ω → E → ℝ),
        WeakSolution D h𝒢₀ hind₀ T (C.perturb p) ξ₀ X₁ Y₁ Z₁ U₁ →
        WeakSolution D h𝒢₀ hind₀ T (C.perturb p) ξ₀ X₂ Y₂ Z₂ U₂ →
        (∀ i, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, X₁ i t ω = X₂ i t ω)
          ∧ (∀ k, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, Y₁ k t ω = Y₂ k t ω)
          ∧ (∀ k j, LevyStochCalc.Brownian.Ito.energy P T
              (fun ω s => Z₁ k s ω j - Z₂ k s ω j) = 0)
          ∧ ∀ k, LevyStochCalc.Poisson.Compensated.markedEnergy P ν T
              (fun ω s e => U₁ k s ω e - U₂ k s ω e) = 0)
    ∧ ∀ L : ℝ, Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L (C.perturb p) →
      ∀ (L₂ : ℝ) (C₂ : Coeffs ν n n d) (ξ₂ : Ω → EuclideanSpace ℝ (Fin n)),
        JointBorel T C₂ → Assumption22 (enlJoint 𝒢₀ D h𝒢₀) P T C₂ ξ₂ →
        Assumption23 (enlJoint 𝒢₀ D h𝒢₀) P T L₂ C₂ →
        ∀ (X₁ X₂ : Fin n → ℝ → Ω → ℝ) (Y₁ Y₂ : Fin n → ℝ → Ω → ℝ)
          (Z₁ Z₂ : Fin n → ℝ → Ω → Fin d → ℝ) (U₁ U₂ : Fin n → ℝ → Ω → E → ℝ),
        Solution D h𝒢₀ hind₀ T (C.perturb p) ξ₀ X₁ Y₁ Z₁ U₁ →
        Solution D h𝒢₀ hind₀ T C₂ ξ₂ X₂ Y₂ Z₂ U₂ →
        supSize P ν T (fun i t ω => X₁ i t ω - X₂ i t ω) (fun k t ω => Y₁ k t ω - Y₂ k t ω)
            (fun k t ω j => Z₁ k t ω j - Z₂ k t ω j)
            (fun k t ω e => U₁ k t ω e - U₂ k t ω e)
          ≤ ENNReal.ofReal (Cstab T L ‖GX G‖ (sMin G ^ 2)⁻¹ α β₁ β₂)
            * dataSize P ν T (fun i ω => ξ₀ ω i - ξ₂ ω i)
              (fun i ω s => driftProc P T (C.perturb p) X₂ Y₂ Z₂ U₂ i ω s
                - driftProc P T C₂ X₂ Y₂ Z₂ U₂ i ω s)
              (fun i s ω j => diffusionProc P T (C.perturb p) X₂ Y₂ Z₂ U₂ i s ω j
                - diffusionProc P T C₂ X₂ Y₂ Z₂ U₂ i s ω j)
              (fun i s ω e =>
                jumpProc T (coeffJump P T (C.perturb p) (leftLimProc X₂) (leftLimProc Y₂) Z₂ U₂)
                    i s ω e
                  - jumpProc T (coeffJump P T C₂ (leftLimProc X₂) (leftLimProc Y₂) Z₂ U₂) i s ω e)
              (fun k ω s => driverProc P T (C.perturb p) X₂ Y₂ Z₂ U₂ k ω s
                - driverProc P T C₂ X₂ Y₂ Z₂ U₂ k ω s)
              (fun k ω => terminalVal P T (C.perturb p) X₂ k ω - terminalVal P T C₂ X₂ k ω)

/-- Corollary 3.6, (3.5) gives (3.4). On every filtered probability space, for `n ≥ 1`, `T > 0`,
`m = n` and every coupling matrix `G`, a perturbation `p` whose interior coefficients do not
depend on the tuple and which satisfies (3.5) with a constant `L_p`,
`|δp_b| + |δp_σ|_F + ‖δp_h‖_{L²(ν)} + |δp_f| ≤ L_p W₂(μ, μ')` along the diagonal, satisfies (3.4)
with `c_pert = ‖G‖ L_p`, `‖G‖` the operator norm of `G`. -/
def cor_robust_lip : Prop :=
  ∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (ℱ : MeasureTheory.Filtration ℝ ‹MeasurableSpace Ω›) {E : Type v} [MeasurableSpace E]
    (ν : Measure E) [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E] (n d : ℕ),
    0 < n → ∀ T : ℝ, 0 < T → ∀ (Lₚ : ℝ) (G : Matrix (Fin n) (Fin n) ℝ) (p : Coeffs ν n n d),
    p.TupleIndep → LawLip35 ℱ P T Lₚ p → PairingBound34 ℱ P T G (‖GX G‖ * Lₚ) p

/-- Proposition 3.8 (strictness of expected diagonal monotonicity). Let `n = m = 1`, `d ≥ 1`,
`G = 1`, `β₁ > 0` and `0 < ε < β₁`, and let `b` be the drift (3.6),
`b(t, θ, μ) = −β₁ y + ε g₀(y − m_Y(μ))`, `g₀(r) = max(−1, min(1, r))`, with
`m_Y(μ) = ∫_H y μ(dθ)` the `Y`-marginal mean. Then `b` is free-measure `W₂`-Lipschitz with
constant `β₁ + ε`: `|b(t, θ, μ) − b(t, θ', μ')| ≤ (β₁ + ε)(|y − y'| + W₂(μ, μ'))` at all points
`θ, θ' ∈ H` and laws `μ, μ' ∈ P₂(H)`, with `W₂` that of the Hilbert norm of `H`; along all
diagonal inputs `(Θ, Law Θ), (Θ', Law Θ')` the pairing `⟨δb, δY⟩` is integrable and (3.7),
`𝔼⟨δb, δY⟩ ≤ −(β₁ − ε) 𝔼|δY|²`, holds; and for every `β ≥ 0` the pointwise bound
`⟨δb, δy⟩ ≤ −β |δy|²` fails at a pair of points and laws `(θ, μ), (θ', μ')` with
`θ ∈ supp μ` and `θ' ∈ supp μ'`. -/
def prop_strict : Prop :=
  ∀ {E : Type v} [MeasurableSpace E] (ν : Measure E) [SigmaFinite ν]
    [MeasurableSpace.CountablyGenerated E] (d : ℕ), 0 < d →
    ∀ β₁ ε : ℝ, 0 < β₁ → 0 < ε → ε < β₁ →
    (∀ (t : ℝ) (θ θ' : TupleH ν 1 1 d) (μ μ' : MVFBSDEJ.Law.P2 (TupleH ν 1 1 d)),
      ‖clampDrift β₁ ε t θ μ - clampDrift β₁ ε t θ' μ'‖
        ≤ (β₁ + ε) * (‖θ.2.1 - θ'.2.1‖ + w2H μ μ'))
    ∧ (∀ {Ω : Type u} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P] (t : ℝ)
        (Θ Θ' : Ω → TupleH ν 1 1 d), MemLp Θ 2 P → MemLp Θ' 2 P →
        Integrable (fun ω => inner ℝ (clampDrift β₁ ε t (Θ ω) (MVFBSDEJ.Law.lawP2 P Θ)
          - clampDrift β₁ ε t (Θ' ω) (MVFBSDEJ.Law.lawP2 P Θ')) ((Θ ω).2.1 - (Θ' ω).2.1)) P
        ∧ ∫ ω, inner ℝ (clampDrift β₁ ε t (Θ ω) (MVFBSDEJ.Law.lawP2 P Θ)
              - clampDrift β₁ ε t (Θ' ω) (MVFBSDEJ.Law.lawP2 P Θ')) ((Θ ω).2.1 - (Θ' ω).2.1) ∂P
            ≤ -(β₁ - ε) * ∫ ω, ‖(Θ ω).2.1 - (Θ' ω).2.1‖ ^ 2 ∂P)
    ∧ ∀ t β : ℝ, 0 ≤ β → ∃ (θ θ' : TupleH ν 1 1 d) (μ μ' : MVFBSDEJ.Law.P2 (TupleH ν 1 1 d)),
      θ ∈ μ.law.support ∧ θ' ∈ μ'.law.support
        ∧ ¬ inner ℝ (clampDrift β₁ ε t θ μ - clampDrift β₁ ε t θ' μ') (θ.2.1 - θ'.2.1)
          ≤ -β * ‖θ.2.1 - θ'.2.1‖ ^ 2

end MVFBSDEJ.PaperSpec
