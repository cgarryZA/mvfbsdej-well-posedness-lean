import MVFBSDEJ.WellPosedness.Enlarged.Driver
import LevyStochCalc.Driver.JointFiltration
import LevyStochCalc.Driver.TrivialAtNegative

/-!
# Example 5.2: the filtrations at zero jump intensity

Removing the Poisson channel leaves the filtration generated by the Brownian motion `W` and the
initial σ-field. At the zero intensity `ν = 0` the reference intensity `dt ⊗ ν` of the Poisson
random measure `N` of a Lévy driver vanishes, so every count `N(B)` is almost surely `0`, and
every set of the natural filtration of `N` is null or conull. Such sets lie in every augmentation
by the null sets, so the initially enlarged joint filtration `enlJoint 𝒢₀ D h𝒢₀` of a driver of
zero intensity is `enlBrownian 𝒢₀ D.W h𝒢₀`, the usual augmentation of the filtration generated by
its Brownian motion and an initial σ-algebra `𝒢₀`.

## Main definitions

* `enlBrownian` — the usual augmentation of the filtration generated by a Brownian motion and an
  initial σ-algebra.

## Main statements

* `trivialSigma_le_aug` — the null-or-conull sets lie in every augmentation.
* `naturalFiltration_poisson_le_aug` — at `ν = 0` the natural filtration of the Poisson random
  measure lies in every augmentation.
* `enlJoint_nu_zero_eq` — at `ν = 0` the enlarged joint filtration is the enlarged Brownian one.
-/

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal symmDiff

namespace MVFBSDEJ.WellPosedness.Existence

open LevyStochCalc LevyStochCalc.Probability MVFBSDEJ.WellPosedness.Enlarged

universe u v w

variable {Ω : Type u} {𝒢₀ m : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P] {E : Type v} [MeasurableSpace E] {d : ℕ}

/-! ### Null-or-conull sets and zero counts -/

/-- **The null-or-conull sets lie in every augmentation by the null sets.** -/
theorem trivialSigma_le_aug : trivialSigma mΩ P ≤ aug m mΩ P := by
  rintro A ⟨hA, h0 | h1⟩
  · exact measurableSet_aug_of_null hA h0
  · refine measurableSet_aug_of_ae_eq hA (@MeasurableSet.univ Ω (aug m mΩ P)) ?_
    have hs : A ∆ Set.univ = Aᶜ := by
      ext ω
      simp [Set.mem_symmDiff]
    rw [hs]
    exact (prob_compl_eq_zero_iff hA).mpr h1

/-- The reference intensity of the zero intensity vanishes. -/
theorem referenceIntensity_zero : Poisson.referenceIntensity (0 : Measure E) = 0 := by
  simp [Poisson.referenceIntensity]

/-- **At `ν = 0` the natural filtration of the Poisson random measure lies in every augmentation**:
its counts vanish almost surely. -/
theorem naturalFiltration_poisson_le_aug
    (N : Poisson.PoissonRandomMeasure.{u, v, w} P (0 : Measure E)) (s : ℝ) :
    Poisson.naturalFiltration N s ≤ aug m mΩ P := by
  have hseq : Poisson.naturalFiltration N s
      = ⨆ B ∈ { C : Set (ℝ × E) | C ⊆ Set.Iic s ×ˢ Set.univ ∧ MeasurableSet C },
        MeasurableSpace.comap (fun ω => N.N ω B) inferInstance := rfl
  rw [hseq]
  refine iSup₂_le fun B hB => (comap_le_trivialSigma (y := 0) (N.measurable_eval hB.2)
    (Poisson.ae_count_eq_zero_of_intensity_eq_zero N hB.2 ?_)).trans trivialSigma_le_aug
  rw [referenceIntensity_zero, Measure.coe_zero, Pi.zero_apply]

/-! ### The initially enlarged Brownian filtration -/

variable (𝒢₀) in
/-- The usual augmentation of the filtration generated by a Brownian motion `W` and an initial
σ-algebra `𝒢₀`: the right-continuous version of `t ↦ ℱ^W_t ⊔ 𝒢₀`, frozen before time `0` and
augmented by the `P`-null sets. -/
noncomputable abbrev enlBrownian (W : Brownian.Multidim.MultidimBrownianMotion P d)
    (h𝒢₀ : 𝒢₀ ≤ mΩ) : Filtration ℝ mΩ :=
  Brownian.augFiltration (W.naturalFiltration ⊔ Filtration.const ℝ 𝒢₀ h𝒢₀).rightCont P

variable (𝒢₀) in
/-- **At `ν = 0` the enlarged joint filtration is the enlarged Brownian filtration**: for a Lévy
driver of zero intensity, `enlJoint 𝒢₀ D h𝒢₀ = enlBrownian 𝒢₀ D.W h𝒢₀`, the usual augmentation
of the filtration generated by the Brownian motion and `𝒢₀`. -/
theorem enlJoint_nu_zero_eq (D : Driver.LevyDriver.{u, v, w} P d (0 : Measure E))
    (h𝒢₀ : 𝒢₀ ≤ mΩ) : enlJoint 𝒢₀ D h𝒢₀ = enlBrownian 𝒢₀ D.W h𝒢₀ := by
  set A := D.W.naturalFiltration ⊔ Filtration.const ℝ 𝒢₀ h𝒢₀ with hA
  have hA_apply : ∀ s, A s = D.W.naturalFiltration s ⊔ 𝒢₀ := fun s => by
    rw [hA, Filtration.coeFn_sup, Pi.sup_apply]
    rfl
  have hAJ : A ≤ initJoint 𝒢₀ D h𝒢₀ := fun s => by
    rw [hA_apply, initJoint_apply]
    exact sup_le_sup_right (D.naturalFiltration_brownian_le s) _
  have hJA : ∀ s, initJoint 𝒢₀ D h𝒢₀ s ≤ aug (A s) mΩ P := fun s => by
    rw [initJoint_apply, D.filtration_apply]
    have hle : A s ≤ aug (A s) mΩ P := le_aug (A.le s)
    refine sup_le (sup_le ?_ (naturalFiltration_poisson_le_aug D.N s)) ?_
    · exact le_trans (by rw [hA_apply]; exact le_sup_left) hle
    · exact le_trans (by rw [hA_apply]; exact le_sup_right) hle
  refine le_antisymm (fun t => ?_) (fun t => aug_mono (Filtration.rightCont_mono hAJ _))
  change aug ((initJoint 𝒢₀ D h𝒢₀).rightCont (max t 0)) mΩ P
    ≤ aug (A.rightCont (max t 0)) mΩ P
  refine aug_le_of_le_aug ?_
  set r := max t 0
  have hseq : ∀ k : ℕ, r < r + ((k : ℝ) + 1)⁻¹ := fun k => by
    have : (0 : ℝ) < ((k : ℝ) + 1)⁻¹ := by positivity
    linarith
  have hanti : Antitone fun k : ℕ => A (r + ((k : ℝ) + 1)⁻¹) := by
    intro a b hab
    refine A.mono ?_
    have hab' : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab
    have hinv : ((b : ℝ) + 1)⁻¹ ≤ ((a : ℝ) + 1)⁻¹ := by gcongr
    linarith
  have h1 : (initJoint 𝒢₀ D h𝒢₀).rightCont r
      ≤ ⨅ k : ℕ, aug (A (r + ((k : ℝ) + 1)⁻¹)) mΩ P := by
    refine le_iInf fun k => le_trans ?_ (hJA _)
    rw [Filtration.rightCont_eq]
    exact iInf₂_le _ (hseq k)
  rw [aug_iInf_of_antitone hanti] at h1
  have h2 : (⨅ k : ℕ, A (r + ((k : ℝ) + 1)⁻¹)) ≤ A.rightCont r := by
    rw [Filtration.rightCont_eq]
    refine le_iInf₂ fun s hs => ?_
    obtain ⟨k, hk⟩ := exists_nat_one_div_lt (show (0 : ℝ) < s - r by linarith)
    refine le_trans (iInf_le _ k) (A.mono ?_)
    rw [one_div] at hk
    linarith
  exact le_trans h1 (aug_mono h2)

end MVFBSDEJ.WellPosedness.Existence
