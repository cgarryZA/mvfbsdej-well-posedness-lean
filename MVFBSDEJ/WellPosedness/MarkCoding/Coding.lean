import MVFBSDEJ.WellPosedness.MarkCoding.Filtration

/-!
# Coding the marks of a Lévy driver into the Cantor space

Let `(E, ℰ)` be a countably generated measurable space with generating sequence `(Aₙ)`. The
coding map `MeasurableSpace.mapNatBool E : E → (ℕ → Bool)`, `e ↦ (n ↦ 1_{Aₙ}(e))`, is measurable
and initial: `ℰ` is generated by the sets `Aₙ`, each of which is the preimage of a coordinate
cylinder. It need not be injective. The image of a σ-finite measure along an initial map is
σ-finite, since every set of a spanning sequence is the preimage of a measurable set.

For a Lévy driver `D` on `E` with σ-finite intensity `ν`, the coded driver pushes the marks
forward along the coding map. Its mark space `ℕ → Bool` is countably generated with measurable
singletons, and it has the joint natural filtration of `D`.

## Main definitions

* `codedDriver` — the Lévy driver with its marks coded into `ℕ → Bool`.

## Main statements

* `comap_mapNatBool` — the coding map of a countably generated space is initial.
* `sigmaFinite_map_of_comap_eq` — the image of a σ-finite measure along an initial map is
  σ-finite.
* `filtration_codedDriver` — the coded driver has the joint natural filtration of the driver.
-/

open MeasureTheory MeasurableSpace

namespace MVFBSDEJ.WellPosedness.MarkCoding

open LevyStochCalc LevyStochCalc.Driver

universe u v w

variable {E : Type v} [mE : MeasurableSpace E]

/-- The coding map of a countably generated measurable space into `ℕ → Bool` is initial. -/
theorem comap_mapNatBool [CountablyGenerated E] :
    MeasurableSpace.comap (mapNatBool E) (inferInstance : MeasurableSpace (ℕ → Bool)) = mE := by
  refine le_antisymm (measurable_mapNatBool E).comap_le ?_
  conv_lhs => rw [← generateFrom_natGeneratingSequence E]
  refine generateFrom_le ?_
  rintro _ ⟨n, rfl⟩
  refine ⟨(fun y : ℕ → Bool => y n) ⁻¹' {true}, ?_, ?_⟩
  · exact (measurable_pi_apply n) (measurableSet_singleton true)
  · ext x
    simp [mapNatBool]

/-- The image of a σ-finite measure along a measurable initial map is σ-finite. -/
theorem sigmaFinite_map_of_comap_eq {F : Type*} [mF : MeasurableSpace F] {φ : E → F}
    (hφ : Measurable φ) (hc : MeasurableSpace.comap φ mF = mE) (ν : Measure E) [SigmaFinite ν] :
    SigmaFinite (ν.map φ) := by
  have hS : ∀ n, ∃ B : Set F, MeasurableSet B ∧ φ ⁻¹' B = spanningSets ν n := by
    intro n
    have h : MeasurableSet[MeasurableSpace.comap φ mF] (spanningSets ν n) := by
      rw [hc]
      exact measurableSet_spanningSets ν n
    exact h
  choose B hBm hBpre using hS
  refine ⟨⟨fun n => (⋃ k ≤ n, B k) ∪ (⋃ k, B k)ᶜ, fun _ => trivial, fun n => ?_, ?_⟩⟩
  · have hm : MeasurableSet ((⋃ k ≤ n, B k) ∪ (⋃ k, B k)ᶜ) :=
      (MeasurableSet.biUnion (Set.to_countable _) fun k _ => hBm k).union
        (MeasurableSet.iUnion hBm).compl
    rw [Measure.map_apply hφ hm]
    simp only [Set.preimage_union, Set.preimage_compl, Set.preimage_iUnion, hBpre,
      iUnion_spanningSets, Set.compl_univ, Set.union_empty]
    exact measure_biUnion_lt_top (Set.finite_le_nat n) fun k _ => measure_spanningSets_lt_top ν k
  · ext y
    simp only [Set.mem_iUnion, Set.mem_union, Set.mem_compl_iff, Set.mem_univ, iff_true]
    by_cases h : ∃ k, y ∈ B k
    · obtain ⟨k, hk⟩ := h
      exact ⟨k, Or.inl ⟨k, le_rfl, hk⟩⟩
    · exact ⟨0, Or.inr fun ⟨k, hk⟩ => h ⟨k, hk⟩⟩

/-- The image of a σ-finite measure along the coding map is σ-finite. -/
instance sigmaFinite_map_mapNatBool [CountablyGenerated E] (ν : Measure E) [SigmaFinite ν] :
    SigmaFinite (ν.map (mapNatBool E)) :=
  sigmaFinite_map_of_comap_eq (measurable_mapNatBool E) comap_mapNatBool ν

variable [CountablyGenerated E] {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν] {d : ℕ}

/-- The coded driver of a Lévy driver on a countably generated mark space: its marks pushed
forward along the coding map into `ℕ → Bool`. -/
noncomputable abbrev codedDriver (D : LevyDriver.{u, v, w} P d ν) :
    LevyDriver.{u, 0, w} P d (ν.map (mapNatBool E)) :=
  LevyDriver.mapMarks D (measurable_mapNatBool E)

/-- The coded driver has the joint natural filtration of the driver. -/
theorem filtration_codedDriver (D : LevyDriver.{u, v, w} P d ν) :
    (codedDriver D).filtration = D.filtration :=
  LevyDriver.filtration_mapMarks D (measurable_mapNatBool E) comap_mapNatBool

end MVFBSDEJ.WellPosedness.MarkCoding
