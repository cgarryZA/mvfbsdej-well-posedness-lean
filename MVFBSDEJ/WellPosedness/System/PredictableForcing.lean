import MVFBSDEJ.WellPosedness.System.PaperSolutionForced
import MVFBSDEJ.WellPosedness.System.SolvesPathwise
import MVFBSDEJ.WellPosedness.System.SolvesPredictable

/-!
# Forcings with a predictable jump component

The well-posedness paper takes the jump component `q^h` of a forcing of the `λ`-system (4.1)
predictable, measurable for `𝒫 ⊗ ℰ`, while `Forcing` takes it marked progressively measurable.
`PredForcing` is the paper's class: a forcing whose jump component is marked predictable. The
marked predictable σ-algebra is generated by the sets `F × (r, q] × B` with `0 ≤ r`, `F ∈ ℱ_r` and
`ν(B) < ∞`, none of which meets the times `s ≤ 0`; a jump component in this class, vanishing
before `0`, therefore also vanishes at time `0`. The paper's predictable σ-algebra also contains
the sets `F × {0} × B`, `F ∈ ℱ_0`; the time `0` is a null set of times and does not enter the
integrals of (4.1).

The two classes carry the same solutions up to a change of `q^h` by zero energy. A marked
progressive `q^h` of finite energy agrees with a marked predictable process
`dP ⊗ ds ⊗ ν`-almost everywhere on `Ω × [0, T] × E`
(`LevyStochCalc.Probability.exists_markedPredictable_ae_eq`); cut to `(0, T]`, the version still
vanishes off `[0, T]`, and it replaces `q^h` in the forcing (`Forcing.exists_predForcing`). For
`T ≤ 0` the product measure on `Ω × [0, T] × E` is zero and the version is `0`.

`q^h` enters (4.1) only through the compensated Poisson integral of the forward jump integrand
`λ γ + q^h`, which does not change, almost surely at each time of `[0, T]`, when `q^h` is changed
by zero energy. So a solution of `SolvesForced` for one of the two forcings solves it for the
other, with the same `X`, `Y`, `Z`, `U` and `γ`. The paper's solution
notion asks the forward identity at all times of `[0, T]` on one set of full measure; the two
compensated integrals have almost surely càdlàg paths, so they agree at all those times on one
set of full measure, and the same transfer holds for it (`PaperSolutionForced.congr_qh`).

## Main definitions

* `PredForcing` — a forcing of (4.1) with a marked predictable jump component.

## Main statements

* `Forcing.exists_predForcing` — every forcing has a predictable version of its jump component.
* `PaperSolutionForced.congr_qh` — a change of the jump component of the forcing by zero energy
  keeps a solution a solution.
-/

open MeasureTheory Filter Topology
open scoped NNReal ENNReal

namespace MVFBSDEJ.WellPosedness.System

open MVFBSDEJ.WellPosedness.BrownianPoisson MVFBSDEJ.WellPosedness.Stability
  MVFBSDEJ.WellPosedness.Existence LevyStochCalc.BSDEJ.Solves LevyStochCalc

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E] {ν : Measure E}
  {n m d : ℕ}

/-! ### The predictable forcing class -/

/-- **A forcing of the `λ`-system (4.1) in the class of the paper**, over the filtration `ℱ`: a
forcing whose jump component `q^h` is, coordinatewise, marked predictable, that is, measurable
for the σ-algebra on `Ω × ℝ × E` generated by the sets `F × (r, q] × B` with `0 ≤ r`, `F ∈ ℱ_r`
and `ν(B) < ∞`. -/
structure PredForcing (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (P : Measure Ω) (ν : Measure E)
    (T : ℝ) (qb : Fin n → Ω → ℝ → ℝ) (qσ : Fin n → ℝ → Ω → Fin d → ℝ)
    (qh : Fin n → ℝ → Ω → E → ℝ) (qf : Fin m → Ω → ℝ → ℝ) (qg : Fin m → Ω → ℝ) : Prop
    extends Forcing ℱ P ν T qb qσ qh qf qg where
  /-- `q^h` is marked predictable. -/
  qh_pred : ∀ i, Probability.MarkedPredictable ℱ ν fun ω s e => qh i s ω e

variable [SigmaFinite ν] {P : Measure Ω} [IsProbabilityMeasure P]
  {ℱ : Filtration ℝ ‹MeasurableSpace Ω›} {T lam : ℝ}
  {qb : Fin n → Ω → ℝ → ℝ} {qσ : Fin n → ℝ → Ω → Fin d → ℝ} {qh qh' : Fin n → ℝ → Ω → E → ℝ}
  {qf : Fin m → Ω → ℝ → ℝ} {qg : Fin m → Ω → ℝ}

omit [SigmaFinite ν] [IsProbabilityMeasure P] in
/-- For `T ≤ 0` the product of `P`, Lebesgue measure on `[0, T]` and `ν` is zero. -/
theorem markedEnergyMeasure_eq_zero_of_nonpos (hT : T ≤ 0) :
    Poisson.Compensated.markedEnergyMeasure P ν T = 0 := by
  have h0 : volume.restrict (Set.Icc (0 : ℝ) T) = 0 := by
    rw [Measure.restrict_eq_zero, Real.volume_Icc, ENNReal.ofReal_eq_zero]
    linarith
  rw [Poisson.Compensated.markedEnergyMeasure, h0, Measure.zero_prod, Measure.prod_zero]

/-- **Every forcing has a predictable version of its jump component.** For a forcing `q` of the
`λ`-system (4.1), in the presence of a Poisson random measure with intensity `ν`, there is a
marked predictable `q'^h` equal to `q^h` `dP ⊗ ds ⊗ ν`-almost everywhere on `Ω × [0, T] × E`,
coordinatewise, such that `q` with `q^h` replaced by `q'^h` is a forcing in the class of the
paper. -/
theorem Forcing.exists_predForcing (hF : Forcing ℱ P ν T qb qσ qh qf qg)
    (N : Poisson.PoissonRandomMeasure P ν) :
    ∃ qh' : Fin n → ℝ → Ω → E → ℝ, PredForcing ℱ P ν T qb qσ qh' qf qg
      ∧ ∀ i, ∀ᵐ p ∂(Poisson.Compensated.markedEnergyMeasure P ν T),
          qh i p.2.1 p.1 p.2.2 = qh' i p.2.1 p.1 p.2.2 := by
  rcases le_or_gt T 0 with hT | hT
  · refine ⟨0, { hF with
      qh_meas := fun _ => measurable_const
      qh_prog := fun _ => Poisson.Compensated.markedProgressivelyMeasurable_zero ℱ
      qh_vanish := fun _ _ _ _ _ => rfl
      qh_sq := fun _ => by simp [Poisson.Compensated.markedEnergy]
      qh_pred := fun _ => measurable_const }, fun _ => ?_⟩
    rw [markedEnergyMeasure_eq_zero_of_nonpos hT, ae_zero]
    exact eventually_bot
  choose ψ hψpred hψae using fun i : Fin n =>
    Probability.exists_markedPredictable_ae_eq (φ := fun ω s e => qh i s ω e) N (hF.qh_meas i)
      (hF.qh_prog i) hT (hF.qh_sq i)
  set qh' : Fin n → ℝ → Ω → E → ℝ :=
    fun i s ω e => (Set.Ioc (0 : ℝ) T).indicator (fun _ => ψ i ω s e) s
  have hpred : ∀ i, Probability.MarkedPredictable ℱ ν fun ω s e => qh' i s ω e := fun i =>
    Poisson.Compensated.markedPredictable_indicator_Ioc (hψpred i) T
  have hae : ∀ i, ∀ᵐ p ∂(Poisson.Compensated.markedEnergyMeasure P ν T),
      qh i p.2.1 p.1 p.2.2 = qh' i p.2.1 p.1 p.2.2 := fun i => by
    filter_upwards [hψae i,
      Poisson.Compensated.ae_mem_Ioc_markedEnergyMeasure (P := P) (ν := ν) hT.le] with p hp hIoc
    exact hp.trans (Set.indicator_of_mem hIoc fun _ => ψ i p.1 p.2.1 p.2.2).symm
  have hm : ∀ i, Measurable fun p : Ω × ℝ × E => qh' i p.2.1 p.1 p.2.2 := fun i =>
    (hpred i).mono (Probability.markedPredictableSigma_le ℱ ν) le_rfl
  have h0 : ∀ i, Poisson.Compensated.markedEnergy P ν T
      (fun ω s e => qh i s ω e - qh' i s ω e) = 0 := fun i =>
    markedEnergy_sub_eq_zero_of_ae_eq (φ₁ := fun ω s e => qh i s ω e)
      (φ₂ := fun ω s e => qh' i s ω e) (hF.qh_meas i) (hm i) (hae i)
  refine ⟨qh', { hF with
    qh_meas := hm
    qh_prog := fun i => (hpred i).markedProgressivelyMeasurable
    qh_vanish := fun i ω s e hs => Set.indicator_of_notMem (fun hs' => hs ⟨hs'.1.le, hs'.2⟩) _
    qh_sq := fun i => by
      rw [markedEnergy_eq_of_markedEnergy_sub_eq_zero (φ₁ := fun ω s e => qh i s ω e)
        (hF.qh_meas i) (hm i) (h0 i)]
      exact hF.qh_sq i
    qh_pred := hpred }, hae⟩

/-! ### Solutions under a change of the jump forcing -/

variable [MeasurableSpace.CountablyGenerated E]
  {D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν}
  {hℱW : ∀ j : Fin d, LevyStochCalc.Brownian.IsBrownianFiltration (D.W.W j) ℱ}
  {hℱN : LevyStochCalc.Poisson.IsPoissonFiltration D.N ℱ} {C : Coeffs ν n m d}
  {ξ₀ : Fin n → Ω → ℝ} {X : Fin n → ℝ → Ω → ℝ} {Y : Fin m → ℝ → Ω → ℝ}
  {Z : Fin m → ℝ → Ω → Fin d → ℝ} {U : Fin m → ℝ → Ω → E → ℝ} {γ : Fin n → ℝ → Ω → E → ℝ}

/-- **A change of the jump forcing by zero energy keeps a solution in the sense of the paper a
solution**: a solution of the `λ`-forced system (4.1) in the sense of the paper with forcing `q`
solves it, with the same `X`, `Y`, `Z`, `U` and `γ`, for the forcing `q'` that differs from `q`
only in its jump component, when `q^h − q'^h` has zero marked energy on `[0, T]`,
coordinatewise. -/
theorem PaperSolutionForced.congr_qh
    (h : PaperSolutionForced D ℱ hℱW hℱN T lam C ξ₀ qb qσ qh qf qg X Y Z U γ)
    (hF : Forcing ℱ P ν T qb qσ qh' qf qg)
    (hh : ∀ i, Poisson.Compensated.markedEnergy P ν T
      (fun ω s e => qh i s ω e - qh' i s ω e) = 0) :
    PaperSolutionForced D ℱ hℱW hℱN T lam C ξ₀ qb qσ qh' qf qg X Y Z U γ := by
  have hd : ∀ i, Poisson.Compensated.markedEnergy P ν T
      (fun ω s e => (lam * jumpProc T γ i s ω e + qh i s ω e)
        - (lam * jumpProc T γ i s ω e + qh' i s ω e)) = 0 := fun i => by
    simpa only [add_sub_add_left_eq_sub] using hh i
  have hγm : ∀ i, Measurable fun p : Ω × ℝ × E =>
      lam * jumpProc T γ i p.2.1 p.1 p.2.2 + qh' i p.2.1 p.1 p.2.2 := fun i =>
    measurable_marked_add_of_add (A := fun s ω e => lam * jumpProc T γ i s ω e) (h.γ_meas i)
      (h.forcing.qh_meas i) (hF.qh_meas i)
  have hγp : ∀ i, Probability.MarkedProgressivelyMeasurable ℱ fun ω s e =>
      lam * jumpProc T γ i s ω e + qh' i s ω e := fun i =>
    markedProgressivelyMeasurable_add_of_add (h.γ_prog i) (h.forcing.qh_prog i) (hF.qh_prog i)
  have hγq : ∀ i, Poisson.Compensated.markedEnergy P ν T
      (fun ω s e => lam * jumpProc T γ i s ω e + qh' i s ω e) ≠ ⊤ := fun i => by
    rw [markedEnergy_eq_of_markedEnergy_sub_eq_zero
      (φ₁ := fun ω s e => lam * jumpProc T γ i s ω e + qh i s ω e) (h.γ_meas i) (hγm i) (hd i)]
    exact h.γ_sq i
  refine { h with forcing := hF, γ_meas := hγm, γ_prog := hγp, γ_sq := hγq, fwd := fun i => ?_ }
  obtain ⟨M, hMae, hMcad, hid⟩ := h.fwd i
  refine ⟨M, hMae, hMcad, ?_⟩
  have hI : ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T,
      Poisson.Compensated.stochasticIntegral D.N ℱ hℱN
          (fun ω' s e => lam * jumpProc T γ i s ω' e + qh i s ω' e) (h.γ_meas i) (h.γ_prog i)
          (marked_sq_int_global_of_vanishing (forcedJump_of_notMem h.forcing.qh_vanish lam i)
            (h.γ_sq i)) t ω
        = Poisson.Compensated.stochasticIntegral D.N ℱ hℱN
          (fun ω' s e => lam * jumpProc T γ i s ω' e + qh' i s ω' e) (hγm i) (hγp i)
          (marked_sq_int_global_of_vanishing (forcedJump_of_notMem hF.qh_vanish lam i)
            (hγq i)) t ω := by
    rcases lt_or_ge T 0 with hT | hT
    · exact ae_of_all _ fun ω t ht => absurd (ht.1.trans ht.2) (not_le.mpr hT)
    refine ae_forall_Icc_eq_of_ae_rightContinuous hT (fun t ht =>
      compensatedIntegral_congr_of_markedEnergy D.N hℱN
        (φ₁ := fun ω s e => lam * jumpProc T γ i s ω e + qh i s ω e)
        (φ₂ := fun ω s e => lam * jumpProc T γ i s ω e + qh' i s ω e) _ _ _ _ _ _ (hd i) ht.2)
      ?_ ?_
    · exact (Poisson.Compensated.stochasticIntegral_cadlag D.N ℱ hℱN _ _ _ _).mono
        fun _ hω t => (hω t).1
    · exact (Poisson.Compensated.stochasticIntegral_cadlag D.N ℱ hℱN _ _ _ _).mono
        fun _ hω t => (hω t).1
  filter_upwards [hid, hI] with ω h1 h2 t ht
  rw [h1 t ht, h2 t ht]

end MVFBSDEJ.WellPosedness.System
