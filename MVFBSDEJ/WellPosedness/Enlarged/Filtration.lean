import LevyStochCalc.BSDEJ.Solves

/-!
# The initially enlarged joint filtration of a Lévy driver

Let `D` be a Lévy driver with joint natural filtration `ℱ = D.filtration`, and let `𝒢₀` be a
sub-σ-algebra of the ambient σ-algebra. The joint filtration enlarged at time `0` by `𝒢₀` is
`initJoint 𝒢₀ D h𝒢₀ : t ↦ ℱ_t ⊔ 𝒢₀`. Its usual augmentation is

`enlJoint 𝒢₀ D h𝒢₀ = augFiltration (initJoint 𝒢₀ D h𝒢₀)₊ P`,

the right-continuous version of `initJoint 𝒢₀ D h𝒢₀`, frozen before time `0` and augmented at
each time by the `P`-null sets. With `𝒢₀` independent of the driver, this is the filtration of
the model of the well-posedness paper: the usual augmentation of the filtration generated by the
driver and an independent initial σ-algebra.

The usual conditions come from the generic lemmas on the augmentation of a right-continuous
filtration: `enlJoint 𝒢₀ D h𝒢₀` is right-continuous, its time-`0` field contains every `P`-null
set, and its right-continuation is constant before time `0`. It contains `𝒢₀` at time `0` and
the joint filtration at every time, and at a time `T ≥ 0` it lies in the augmentation of
`ℱ_{T+1} ⊔ 𝒢₀`.

## Main definitions

* `initJoint` — the joint filtration joined with the constant filtration `𝒢₀`.
* `enlJoint` — its right-continuous version, augmented by the null sets.

## Main statements

* `isRightContinuous_enlJoint` — `enlJoint 𝒢₀ D h𝒢₀` is right-continuous.
* `hF0_enlJoint` — its right-continuation is constant before time `0`.
* `measurableSet_enlJoint_of_null` — its time-`0` field contains every null set.
* `le_enlJoint_zero` — `𝒢₀ ≤ enlJoint 𝒢₀ D h𝒢₀ 0`.
* `filtration_le_enlJoint` — it contains the joint filtration.
* `enlJoint_le_aug_succ` — `enlJoint 𝒢₀ D h𝒢₀ T ≤ aug (ℱ_{T+1} ⊔ 𝒢₀)` for `T ≥ 0`.
-/

open MeasureTheory

namespace MVFBSDEJ.WellPosedness.Enlarged

open LevyStochCalc LevyStochCalc.Probability

universe u v w

section Generic

/-- The right-continuous version of a filtration is monotone in the filtration. -/
theorem Filtration.rightCont_mono {Ω ι : Type*} {m : MeasurableSpace Ω} [PartialOrder ι]
    {ℱ 𝒢 : MeasureTheory.Filtration ι m} (h : ℱ ≤ 𝒢) : ℱ.rightCont ≤ 𝒢.rightCont := by
  letI := Preorder.topology ι
  haveI : OrderTopology ι := ⟨rfl⟩
  intro i
  rw [MeasureTheory.Filtration.rightCont_apply, MeasureTheory.Filtration.rightCont_apply]
  split_ifs
  · exact iInf₂_mono fun j _ => h j
  · exact h i

end Generic

variable {Ω : Type u} {𝒢₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {E : Type v}
  [MeasurableSpace E] {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]
  {d : ℕ}

variable (𝒢₀) in
/-- The joint filtration of a Lévy driver enlarged at time `0` by the σ-algebra `𝒢₀`:
`t ↦ ℱ_t ⊔ 𝒢₀`. -/
noncomputable abbrev initJoint (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν)
    (h𝒢₀ : 𝒢₀ ≤ mΩ) : MeasureTheory.Filtration ℝ mΩ :=
  D.filtration ⊔ MeasureTheory.Filtration.const ℝ 𝒢₀ h𝒢₀

variable (𝒢₀) in
/-- The usual augmentation of the initially enlarged joint filtration: its right-continuous
version, frozen before time `0` and augmented by the `P`-null sets. -/
noncomputable abbrev enlJoint (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν)
    (h𝒢₀ : 𝒢₀ ≤ mΩ) : MeasureTheory.Filtration ℝ mΩ :=
  Brownian.augFiltration (initJoint 𝒢₀ D h𝒢₀).rightCont P

variable (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)

/-- The initially enlarged joint filtration at time `t` is `ℱ_t ⊔ 𝒢₀`. -/
theorem initJoint_apply (t : ℝ) : initJoint 𝒢₀ D h𝒢₀ t = D.filtration t ⊔ 𝒢₀ := rfl

/-- At a nonnegative time, the enlarged filtration is the augmentation of the right-continuous
version of the initially enlarged joint filtration. -/
theorem enlJoint_eq_aug {t : ℝ} (ht : 0 ≤ t) :
    enlJoint 𝒢₀ D h𝒢₀ t = aug ((initJoint 𝒢₀ D h𝒢₀).rightCont t) mΩ P := by
  change aug ((initJoint 𝒢₀ D h𝒢₀).rightCont (max t 0)) mΩ P = _
  rw [max_eq_left ht]

/-- The enlarged filtration is right-continuous. -/
instance isRightContinuous_enlJoint : (enlJoint 𝒢₀ D h𝒢₀).IsRightContinuous :=
  Brownian.isRightContinuous_augFiltration _ P

/-- The right-continuation of the enlarged filtration is constant before time `0`. -/
theorem hF0_enlJoint (t : ℝ) (ht : t ≤ 0) :
    (enlJoint 𝒢₀ D h𝒢₀).rightCont 0 ≤ (enlJoint 𝒢₀ D h𝒢₀).rightCont t :=
  Brownian.hF0_augFiltration _ P t ht

/-- The enlarged filtration is constant before time `0`. -/
theorem enlJoint_le_of_nonpos {t : ℝ} (ht : t ≤ 0) :
    enlJoint 𝒢₀ D h𝒢₀ 0 ≤ enlJoint 𝒢₀ D h𝒢₀ t :=
  le_of_eq (Brownian.augFiltration_of_nonpos _ P ht).symm

/-- Every `P`-null set lies in the time-`0` field of the enlarged filtration. -/
theorem measurableSet_enlJoint_of_null {s : Set Ω} (hs : MeasurableSet s) (h0 : P s = 0) :
    MeasurableSet[enlJoint 𝒢₀ D h𝒢₀ 0] s :=
  Brownian.measurableSet_augFiltration_of_null _ P hs h0

/-- The initial σ-algebra `𝒢₀` lies in the time-`0` field of the enlarged filtration. -/
theorem le_enlJoint_zero : 𝒢₀ ≤ enlJoint 𝒢₀ D h𝒢₀ 0 :=
  le_trans (le_trans (le_sup_right : 𝒢₀ ≤ D.filtration 0 ⊔ 𝒢₀)
      ((initJoint 𝒢₀ D h𝒢₀).le_rightCont 0))
    (Brownian.le_augFiltration _ P 0)

/-- The joint filtration lies in the enlarged filtration at every time. -/
theorem filtration_le_enlJoint (t : ℝ) : D.filtration t ≤ enlJoint 𝒢₀ D h𝒢₀ t :=
  le_trans (le_trans (le_sup_left : D.filtration t ≤ D.filtration t ⊔ 𝒢₀)
      ((initJoint 𝒢₀ D h𝒢₀).le_rightCont t))
    (Brownian.le_augFiltration _ P t)

/-- At a time `T ≥ 0` the enlarged filtration lies in the augmentation of `ℱ_{T+1} ⊔ 𝒢₀`. -/
theorem enlJoint_le_aug_succ {T : ℝ} (hT : 0 ≤ T) :
    enlJoint 𝒢₀ D h𝒢₀ T ≤ aug (D.filtration (T + 1) ⊔ 𝒢₀) mΩ P := by
  rw [enlJoint_eq_aug D h𝒢₀ hT]
  refine aug_mono ?_
  rw [MeasureTheory.Filtration.rightCont_eq]
  exact iInf₂_le (T + 1) (by linarith)

end MVFBSDEJ.WellPosedness.Enlarged
