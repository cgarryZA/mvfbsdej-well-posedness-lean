import Dissertation.WellPosedness.Existence.GlobalEnl
import Dissertation.WellPosedness.Spec.Thm33
import Dissertation.WellPosedness.System.PaperWeakSolutionForcedInt
import Dissertation.WellPosedness.System.PredictableForcing

/-!
# The solution notion of the well-posedness paper

Statement and equation numbers refer to the well-posedness paper at `1f67672`.

A solution of (1.1) is a tuple `Θ = (X, Y, Z, U)` of the space `𝕊` of §3 satisfying both identities
of (1.1) almost surely for every `t ∈ [0, T]`, with `h` evaluated at the predictable tuple
`(Θ⁻_t, μ⁻_t)`. The filtration is the usual augmentation of the one generated by `W`, `N` and an
independent initial σ-field `ℱ₀` (§2), and every Poisson integral is read through a
`𝒫 ⊗ ℰ`-measurable representative of its integrand ((2.4)).

## Main definitions

* `Dissertation.PaperSpec.A.Solution` — `Θ` solves (1.1) in `𝕊`.
* `Dissertation.PaperSpec.A.WeakSolution` — `Θ` satisfies (1.1) in `ℍ²`.
* `Dissertation.PaperSpec.A.ForcedSolution`, `WeakForcedSolution` — `Θ` solves the `λ`-forced
  system (4.1) in `𝕊`, resp. in `ℍ²` with `X_T ∈ L²`.
* `Dissertation.PaperSpec.A.WP` — `WP(λ)`: (4.1) has a unique solution in `𝕊` for every forcing.
-/

open MeasureTheory Filter ProbabilityTheory
open scoped Topology

namespace Dissertation.PaperSpec.A

open Dissertation.WellPosedness.System Dissertation.WellPosedness.Existence
  Dissertation.WellPosedness.Stability

universe u v w

variable {Ω : Type u} {𝒢₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {E : Type v}
  [MeasurableSpace E] {ν : Measure E} [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
  {n m d : ℕ} {P : Measure Ω} [IsProbabilityMeasure P]

/-- `Θ = (X, Y, Z, U)` satisfies (1.1) with coefficients `C` and initial datum `ξ₀` in the space
`ℍ²`, over the usual augmentation of the filtration of the driver `D` enlarged at time `0` by
`𝒢₀`: every path of `X` and of `Y` is càdlàg on `[0, T]`, both are adapted with
`𝔼 ∫_0^T |·|² dt < ∞`, `Z` and `U` are predictable with finite energy and vanish off `[0, T]`,
the integrals of (1.1) along `Θ` exist (the drift and driver integrals pathwise, the stochastic
integrals in `L²`), `Law(X_T) ∈ P₂(ℝⁿ)`, and both identities of (1.1) hold almost surely for
every `t ∈ [0, T]`, the Poisson integral read through a representative `γ` of
`h(t, Θ⁻_t, ·, μ⁻_t)`. -/
def WeakSolution (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (T : ℝ) (C : Coeffs ν n m d)
    (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ)
    (Z : Fin m → ℝ → Ω → Fin d → ℝ) (U : Fin m → ℝ → Ω → E → ℝ) : Prop :=
  (∃ γ : Fin n → ℝ → Ω → E → ℝ,
      Dissertation.WellPosedness.Spec.PaperWeakSolutionIntEnl D h𝒢₀ hind₀ T C
        (fun i ω => ξ₀ ω i) X Y Z U γ)
    ∧ (∀ i ω, ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ l : ℝ, Tendsto (fun s => X i s ω) (𝓝[<] t) (𝓝 l))
    ∧ ∀ k ω, ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ l : ℝ, Tendsto (fun s => Y k s ω) (𝓝[<] t) (𝓝 l)

/-- `Θ = (X, Y, Z, U)` solves (1.1) with coefficients `C` and initial datum `ξ₀` in the space `𝕊`,
over the usual augmentation of the filtration of the driver `D` enlarged at time `0` by `𝒢₀`:
`Θ` satisfies (1.1) in `ℍ²` (`WeakSolution`), and `𝔼 sup_{t ≤ T} |X_t|² < ∞`,
`𝔼 sup_{t ≤ T} |Y_t|² < ∞`. -/
def Solution (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (T : ℝ) (C : Coeffs ν n m d)
    (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ)
    (Z : Fin m → ℝ → Ω → Fin d → ℝ) (U : Fin m → ℝ → Ω → E → ℝ) : Prop :=
  WeakSolution D h𝒢₀ hind₀ T C ξ₀ X Y Z U
    ∧ ∫⁻ ω, (⨆ t ∈ Set.Icc (0 : ℝ) T, esq (fun i => X i t ω)) ∂P < ⊤
    ∧ ∫⁻ ω, (⨆ t ∈ Set.Icc (0 : ℝ) T, esq (fun k => Y k t ω)) ∂P < ⊤

/-- `Θ = (X, Y, Z, U)` solves the `λ`-forced system (4.1) with coefficients `C`, initial datum
`ξ₀` and forcing `q = (q^b, q^σ, q^h, q^f, q^g_T)` in the space `ℍ²`, with `X_T ∈ L²`, over
the usual augmentation of the filtration of the driver `D` enlarged at time `0` by `𝒢₀`: every
path of `X` and of `Y` is càdlàg on `[0, T]`, both are adapted with `𝔼 ∫_0^T |·|² dt < ∞`, `Z` and
`U` are predictable with finite energy and vanish off `[0, T]`, `q` is a square-integrable
forcing, the integrals of (4.1) along `Θ` exist (the drift and driver integrals pathwise, the
stochastic integrals in `L²`), and both identities of (4.1) hold almost surely for every
`t ∈ [0, T]`, the Poisson integral of `λ h(t, Θ⁻_t, ·, μ⁻_t) + q^h_t` read through a
representative `γ` of `h(t, Θ⁻_t, ·, μ⁻_t)`. -/
def WeakForcedSolution (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (T lam : ℝ) (C : Coeffs ν n m d)
    (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (qb : Fin n → Ω → ℝ → ℝ)
    (qσ : Fin n → ℝ → Ω → Fin d → ℝ) (qh : Fin n → ℝ → Ω → E → ℝ) (qf : Fin m → Ω → ℝ → ℝ)
    (qg : Fin m → Ω → ℝ) (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ)
    (Z : Fin m → ℝ → Ω → Fin d → ℝ) (U : Fin m → ℝ → Ω → E → ℝ) : Prop :=
  (∃ γ : Fin n → ℝ → Ω → E → ℝ,
      PaperWeakSolutionForcedInt D (Dissertation.WellPosedness.Enlarged.enlJoint 𝒢₀ D h𝒢₀)
        (Dissertation.WellPosedness.Enlarged.isBrownianFiltration_enlJoint D h𝒢₀ hind₀)
        (Dissertation.WellPosedness.Enlarged.isPoissonFiltration_enlJoint D h𝒢₀ hind₀) T lam C
        (fun i ω => ξ₀ ω i) qb qσ qh qf qg X Y Z U γ)
    ∧ (∀ i ω, ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ l : ℝ, Tendsto (fun s => X i s ω) (𝓝[<] t) (𝓝 l))
    ∧ ∀ k ω, ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ l : ℝ, Tendsto (fun s => Y k s ω) (𝓝[<] t) (𝓝 l)

/-- `Θ = (X, Y, Z, U)` solves the `λ`-forced system (4.1) with coefficients `C`, initial datum
`ξ₀` and forcing `q` in the space `𝕊`, over the usual augmentation of the filtration of the driver
`D` enlarged at time `0` by `𝒢₀`: `Θ` satisfies (4.1) in `ℍ²` (`WeakForcedSolution`), and
`𝔼 sup_{t ≤ T} |X_t|² < ∞`, `𝔼 sup_{t ≤ T} |Y_t|² < ∞`. -/
def ForcedSolution (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (T lam : ℝ) (C : Coeffs ν n m d)
    (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) (qb : Fin n → Ω → ℝ → ℝ)
    (qσ : Fin n → ℝ → Ω → Fin d → ℝ) (qh : Fin n → ℝ → Ω → E → ℝ) (qf : Fin m → Ω → ℝ → ℝ)
    (qg : Fin m → Ω → ℝ) (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ)
    (Z : Fin m → ℝ → Ω → Fin d → ℝ) (U : Fin m → ℝ → Ω → E → ℝ) : Prop :=
  WeakForcedSolution D h𝒢₀ hind₀ T lam C ξ₀ qb qσ qh qf qg X Y Z U
    ∧ ∫⁻ ω, (⨆ t ∈ Set.Icc (0 : ℝ) T, esq (fun i => X i t ω)) ∂P < ⊤
    ∧ ∫⁻ ω, (⨆ t ∈ Set.Icc (0 : ℝ) T, esq (fun k => Y k t ω)) ∂P < ⊤

/-- `WP(λ)` of §4: for the coefficients `C` and the initial datum `ξ₀`, the `λ`-forced system
(4.1) has a unique solution in `𝕊` for every forcing `q` — `q^b, q^σ, q^f` progressively
measurable, `q^h` predictable, all square integrable, `q^g_T ∈ L²(Ω, ℱ_T)` — any two solutions
having `X` and `Y` indistinguishable on `[0, T]` and the energies of the differences of `Z` and
of `U` equal to zero. -/
def WP (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)
    (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (T lam : ℝ) (C : Coeffs ν n m d)
    (ξ₀ : Ω → EuclideanSpace ℝ (Fin n)) : Prop :=
  ∀ (qb : Fin n → Ω → ℝ → ℝ) (qσ : Fin n → ℝ → Ω → Fin d → ℝ) (qh : Fin n → ℝ → Ω → E → ℝ)
    (qf : Fin m → Ω → ℝ → ℝ) (qg : Fin m → Ω → ℝ),
    PredForcing (Dissertation.WellPosedness.Enlarged.enlJoint 𝒢₀ D h𝒢₀) P ν T qb qσ qh qf qg →
    (∃ (X : Fin n → ℝ → Ω → ℝ) (Y : Fin m → ℝ → Ω → ℝ) (Z : Fin m → ℝ → Ω → Fin d → ℝ)
        (U : Fin m → ℝ → Ω → E → ℝ), ForcedSolution D h𝒢₀ hind₀ T lam C ξ₀ qb qσ qh qf qg X Y Z U)
    ∧ ∀ (X₁ X₂ : Fin n → ℝ → Ω → ℝ) (Y₁ Y₂ : Fin m → ℝ → Ω → ℝ)
      (Z₁ Z₂ : Fin m → ℝ → Ω → Fin d → ℝ) (U₁ U₂ : Fin m → ℝ → Ω → E → ℝ),
      ForcedSolution D h𝒢₀ hind₀ T lam C ξ₀ qb qσ qh qf qg X₁ Y₁ Z₁ U₁ →
      ForcedSolution D h𝒢₀ hind₀ T lam C ξ₀ qb qσ qh qf qg X₂ Y₂ Z₂ U₂ →
      (∀ i, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, X₁ i t ω = X₂ i t ω)
        ∧ (∀ k, ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T, Y₁ k t ω = Y₂ k t ω)
        ∧ (∀ k j, LevyStochCalc.Brownian.Ito.energy P T
            (fun ω s => Z₁ k s ω j - Z₂ k s ω j) = 0)
        ∧ ∀ k, LevyStochCalc.Poisson.Compensated.markedEnergy P ν T
            (fun ω s e => U₁ k s ω e - U₂ k s ω e) = 0

end Dissertation.PaperSpec.A
