import Dissertation.WellPosedness.Enlarged.Driver
import LevyStochCalc.Driver.CrossElementary

/-!
# The cross witness over the initially enlarged filtration

A cross witness for a filtration `𝒜` carrying a Lévy driver is a pair of enlargements of `𝒜`:
one for which the Poisson random measure `N` is a Poisson random measure and every Brownian
increment is measurable at every time, and one for which every Brownian coordinate is a Brownian
motion and every compensated mass of `N` is measurable at every time. The joint natural
filtration `ℱ` has one, `(t ↦ (⨆ i, σ(Wⁱ)) ⊔ ℱ^N_t, t ↦ ℱ^W_t ⊔ σ(N))`.

Right-continuous versions preserve a witness, since the right-continuous version is monotone in
the filtration and preserves both driver properties. Joining the two enlargements of `ℱ` with a
σ-algebra `𝒢₀` independent of `⨆ t, ℱ_t` gives a witness for `t ↦ ℱ_t ⊔ 𝒢₀`: both enlargements
lie in `(⨆ i, σ(Wⁱ)) ⊔ σ(N) ≤ ⨆ t, ℱ_t`, so joining them with `𝒢₀` keeps the driver properties.
With the augmentation of a witness this gives a witness for the enlarged filtration
`enlJoint 𝒢₀ D h𝒢₀`.

## Main definitions

* `CrossWitness.rightCont` — the witness for the right-continuous version.
* `crossWitnessInit` — the witness for the initially enlarged joint filtration.
* `crossWitnessEnl` — the witness for the enlarged filtration.
-/

open MeasureTheory ProbabilityTheory

namespace Dissertation.WellPosedness.Enlarged

open LevyStochCalc LevyStochCalc.Driver

universe u v w

variable {Ω : Type u} {𝒢₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {E : Type v}
  [MeasurableSpace E] {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]
  {d : ℕ}

/-- The right-continuous versions of the two enlargements of a cross witness for a filtration
form a cross witness for its right-continuous version. -/
noncomputable def CrossWitness.rightCont {D : LevyDriver.{u, v, w} P d ν}
    {ℱ : MeasureTheory.Filtration ℝ mΩ} (𝒲 : D.CrossWitness ℱ) : D.CrossWitness ℱ.rightCont where
  poissonLarger := 𝒲.poissonLarger.rightCont
  poisson_le := Filtration.rightCont_mono 𝒲.poisson_le
  isPoisson := 𝒲.isPoisson.rightCont
  measurable_increment i s p q :=
    (𝒲.measurable_increment i s p q).mono (𝒲.poissonLarger.le_rightCont s) le_rfl
  brownianLarger := 𝒲.brownianLarger.rightCont
  brownian_le := Filtration.rightCont_mono 𝒲.brownian_le
  isBrownian i := (𝒲.isBrownian i).rightCont
  stronglyMeasurable_compensated s _ hB :=
    (𝒲.stronglyMeasurable_compensated s hB).mono (𝒲.brownianLarger.le_rightCont s)

variable (D : LevyDriver.{u, v, w} P d ν)

/-- The Poisson past joined with the whole Brownian path lies in the σ-algebra generated by the
whole joint filtration. -/
theorem crossPoissonFiltration_le_iSup_filtration (s : ℝ) :
    D.crossPoissonFiltration s ≤ ⨆ t, D.filtration t :=
  (sup_le_sup_left (naturalFiltration_le_sigmaPoisson D.N s) _).trans
    (iSup_sigma_le_iSup_filtration D)

/-- The Brownian past joined with the whole Poisson path lies in the σ-algebra generated by the
whole joint filtration. -/
theorem crossBrownianFiltration_le_iSup_filtration (s : ℝ) :
    D.crossBrownianFiltration s ≤ ⨆ t, D.filtration t :=
  (sup_le_sup_right (D.W.naturalFiltration_le_iSup_sigmaBrownian s) _).trans
    (iSup_sigma_le_iSup_filtration D)

variable (h𝒢₀ : 𝒢₀ ≤ mΩ) (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P)

/-- For a σ-algebra `𝒢₀` independent of the whole joint filtration, the two enlargements of the
joint filtration joined with `𝒢₀` form a cross witness for the initially enlarged joint
filtration. -/
noncomputable def crossWitnessInit : D.CrossWitness (initJoint 𝒢₀ D h𝒢₀) where
  poissonLarger := D.crossPoissonFiltration ⊔ MeasureTheory.Filtration.const ℝ 𝒢₀ h𝒢₀
  poisson_le s := sup_le_sup_right (D.filtration_le_crossPoisson s) 𝒢₀
  isPoisson := isPoissonFiltration_sup_const D.isPoissonFiltration_crossPoisson h𝒢₀
    (crossPoissonFiltration_le_iSup_filtration D)
    (fun _ hB => (comap_count_le_sigmaPoisson D.N hB).trans
      (le_sup_right.trans (iSup_sigma_le_iSup_filtration D)))
    hind₀
  measurable_increment i s p q :=
    (D.measurable_increment_crossPoisson i s p q).mono
      (le_sup_left : D.crossPoissonFiltration s ≤ D.crossPoissonFiltration s ⊔ 𝒢₀) le_rfl
  brownianLarger := D.crossBrownianFiltration ⊔ MeasureTheory.Filtration.const ℝ 𝒢₀ h𝒢₀
  brownian_le s := sup_le_sup_right (D.filtration_le_crossBrownian s) 𝒢₀
  isBrownian j := isBrownianFiltration_sup_const (D.isBrownianFiltration_crossBrownian j) h𝒢₀
    (crossBrownianFiltration_le_iSup_filtration D)
    (fun s t => (Brownian.comap_increment_le_sigmaBrownian (D.W.W j) s t).trans
      ((le_iSup (fun i => Brownian.sigmaBrownian (D.W.W i)) j).trans
        (le_sup_left.trans (iSup_sigma_le_iSup_filtration D))))
    hind₀
  stronglyMeasurable_compensated s _ hB :=
    (D.stronglyMeasurable_compensated_crossBrownian s hB).mono
      (le_sup_left : D.crossBrownianFiltration s ≤ D.crossBrownianFiltration s ⊔ 𝒢₀)

/-- For a σ-algebra `𝒢₀` independent of the whole joint filtration, the augmented right-continuous
versions of the two enlargements of the initially enlarged joint filtration form a cross witness
for the enlarged filtration. -/
noncomputable def crossWitnessEnl : D.CrossWitness (enlJoint 𝒢₀ D h𝒢₀) :=
  (CrossWitness.rightCont (crossWitnessInit D h𝒢₀ hind₀)).aug

end Dissertation.WellPosedness.Enlarged
