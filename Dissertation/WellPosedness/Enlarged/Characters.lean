import LevyStochCalc.Driver.JointCharacters

/-!
# Product characters separate on the initially enlarged joint σ-algebra

A σ-algebra `𝒢₀` is generated by the indicators `1_A` of its sets. Adjoining these indicators to
the joint family of a Lévy driver — the coordinate values of the Brownian motion before `T` and
the window counts of the Poisson random measure before `T` — gives a family of real random
variables generating `σ(W_{≤T}) ⊔ windowSigma N T ⊔ 𝒢₀`, whose augmentation contains
`ℱ_T ⊔ 𝒢₀`. Its cylinder characters are the products

`e^{i ∑ w_p W_{t_p}} · e^{i ∑ v_B N(B)} · e^{i ∑ u_A 1_A}`,

so an integrable weight measurable for the augmentation of `ℱ_T ⊔ 𝒢₀` and integrating to zero
against every such product vanishes almost everywhere.

## Main definitions

* `enlFamily` — the joint family of the driver together with the indicators of the sets of
  `𝒢₀`.

## Main statements

* `iSup_comap_indicator_eq` — the indicators of the sets of `𝒢₀` generate `𝒢₀`.
* `iSup_comap_enlFamily` — the enlarged family generates `σ(W_{≤T}) ⊔ windowSigma N T ⊔ 𝒢₀`.
* `ae_eq_zero_of_integral_char_enl` — product characters separate on the augmentation of
  `ℱ_T ⊔ 𝒢₀`.
-/

open MeasureTheory ProbabilityTheory
open scoped RealInnerProductSpace

namespace Dissertation.WellPosedness.Enlarged

open LevyStochCalc LevyStochCalc.Probability LevyStochCalc.Driver

universe u v w

/-- The indicators of the sets of a σ-algebra generate it. -/
theorem iSup_comap_indicator_eq {Ω : Type u} (𝒢₀ : MeasurableSpace Ω) :
    ⨆ A : {A : Set Ω // MeasurableSet[𝒢₀] A},
      MeasurableSpace.comap ((A : Set Ω).indicator fun _ => (1 : ℝ)) inferInstance = 𝒢₀ := by
  refine le_antisymm (iSup_le fun A => ?_) fun s hs => ?_
  · exact (measurable_const.indicator A.2 : Measurable[𝒢₀] _).comap_le
  · have hs' : MeasurableSet[MeasurableSpace.comap (s.indicator fun _ => (1 : ℝ))
        inferInstance] s := by
      refine ⟨{1}, measurableSet_singleton 1, ?_⟩
      ext ω
      by_cases hω : ω ∈ s <;> simp [ hω]
    exact le_iSup (fun A : {A : Set Ω // MeasurableSet[𝒢₀] A} =>
      MeasurableSpace.comap ((A : Set Ω).indicator fun _ => (1 : ℝ)) inferInstance) ⟨s, hs⟩ s hs'

variable {Ω : Type u} {𝒢₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {E : Type v}
  [MeasurableSpace E] {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]
  {d : ℕ}

variable (𝒢₀) in
/-- The joint family of a Lévy driver before `T` — the coordinate values of the Brownian motion
and the window counts of the Poisson random measure — together with the indicators of the sets
of `𝒢₀`. -/
noncomputable def enlFamily (D : LevyDriver.{u, v, w} P d ν) (T : ℝ) :
    ((Fin d × Set.Iic T) ⊕ Poisson.WindowSet E ν T) ⊕ {A : Set Ω // MeasurableSet[𝒢₀] A} →
      Ω → ℝ :=
  Sum.elim (D.jointFamily T) fun A => (A : Set Ω).indicator fun _ => 1

variable (D : LevyDriver.{u, v, w} P d ν) (h𝒢₀ : 𝒢₀ ≤ mΩ)

include h𝒢₀ in
/-- Every member of the enlarged family is measurable. -/
theorem measurable_enlFamily (T : ℝ) : ∀ i, Measurable (enlFamily 𝒢₀ D T i)
  | Sum.inl i => D.measurable_jointFamily T i
  | Sum.inr A => measurable_const.indicator (h𝒢₀ _ A.2)

/-- The enlarged family generates `σ(W_{≤T}) ⊔ windowSigma N T ⊔ 𝒢₀`. -/
theorem iSup_comap_enlFamily (T : ℝ) :
    D.jointWindowSigma T ⊔ 𝒢₀
      = ⨆ i, MeasurableSpace.comap (enlFamily 𝒢₀ D T i) inferInstance := by
  rw [iSup_sum, D.jointWindowSigma_eq_iSup_comap T]
  congr 1
  exact (iSup_comap_indicator_eq 𝒢₀).symm

include h𝒢₀ in
/-- The joint natural filtration at `T` joined with `𝒢₀` lies below the augmentation of
`σ(W_{≤T}) ⊔ windowSigma N T ⊔ 𝒢₀`. -/
theorem filtration_sup_le_aug_jointWindowSigma (T : ℝ) :
    D.filtration T ⊔ 𝒢₀ ≤ aug (D.jointWindowSigma T ⊔ 𝒢₀) mΩ P :=
  sup_le ((D.filtration_le_aug_jointWindowSigma T).trans (aug_mono le_sup_left))
    (le_sup_right.trans (le_aug (sup_le (D.jointWindowSigma_le T) h𝒢₀)))

/-- A cylinder character of the enlarged family is a product of a Brownian cylinder character, a
window character and a character of finitely many indicators of sets of `𝒢₀`. -/
theorem sum_enlFamily_eq (T : ℝ)
    (F : Finset (((Fin d × Set.Iic T) ⊕ Poisson.WindowSet E ν T) ⊕
      {A : Set Ω // MeasurableSet[𝒢₀] A})) (w : F → ℝ) (ω : Ω) :
    (∑ i : F, enlFamily 𝒢₀ D T i ω * w i)
      = ((∑ p : F.toLeft.toLeft, (D.W.W p.1.1).W (p.1.2 : ℝ) ω
            * extendZero F w (Sum.inl (Sum.inl p)))
          + ∑ B : F.toLeft.toRight, (D.N.N ω ((B : Poisson.WindowSet E ν T) : Set (ℝ × E))).toReal
            * extendZero F w (Sum.inl (Sum.inr B)))
        + ∑ A : F.toRight, ((A : {A : Set Ω // MeasurableSet[𝒢₀] A}) : Set Ω).indicator
            (fun _ => (1 : ℝ)) ω * extendZero F w (Sum.inr A) := by
  have h1 : (∑ i : F, enlFamily 𝒢₀ D T i ω * w i)
      = ∑ i ∈ F, enlFamily 𝒢₀ D T i ω * extendZero F w i := by
    rw [← Finset.sum_coe_sort F (fun i => enlFamily 𝒢₀ D T i ω * extendZero F w i)]
    exact Finset.sum_congr rfl fun i _ => by rw [extendZero_coe]
  rw [h1, LevyStochCalc.Driver.Finset.sum_toLeft_add_sum_toRight,
    LevyStochCalc.Driver.Finset.sum_toLeft_add_sum_toRight F.toLeft
      (fun a => enlFamily 𝒢₀ D T (Sum.inl a) ω * extendZero F w (Sum.inl a)),
    Finset.sum_coe_sort F.toLeft.toLeft
      (fun p => (D.W.W p.1).W (p.2 : ℝ) ω * extendZero F w (Sum.inl (Sum.inl p))),
    Finset.sum_coe_sort F.toLeft.toRight
      (fun B => (D.N.N ω ((B : Poisson.WindowSet E ν T) : Set (ℝ × E))).toReal
        * extendZero F w (Sum.inl (Sum.inr B))),
    Finset.sum_coe_sort F.toRight
      (fun A => ((A : {A : Set Ω // MeasurableSet[𝒢₀] A}) : Set Ω).indicator
        (fun _ => (1 : ℝ)) ω * extendZero F w (Sum.inr A))]
  rfl

include h𝒢₀ in
/-- **Product characters separate on the initially enlarged joint σ-algebra.** An integrable
weight, almost everywhere strongly measurable for the augmentation of `ℱ_T ⊔ 𝒢₀` and integrating
to zero against every product of a Brownian cylinder character, a window character and a
character of finitely many indicators of sets of `𝒢₀`, vanishes almost everywhere. -/
theorem ae_eq_zero_of_integral_char_enl (T : ℝ) {Z : Ω → ℂ} (hZ : Integrable Z P)
    (hZm : AEStronglyMeasurable[aug (D.filtration T ⊔ 𝒢₀) mΩ P] Z P)
    (h : ∀ (F : Finset (Fin d × Set.Iic T)) (G : Finset (Poisson.WindowSet E ν T))
      (H : Finset {A : Set Ω // MeasurableSet[𝒢₀] A}) (w : F → ℝ) (v : G → ℝ) (u : H → ℝ),
      ∫ ω, Complex.exp (((∑ p : F, (D.W.W p.1.1).W (p.1.2 : ℝ) ω * w p : ℝ) : ℂ) * Complex.I)
        * Complex.exp (((∑ B : G, (D.N.N ω ((B : Poisson.WindowSet E ν T) : Set (ℝ × E))).toReal
            * v B : ℝ) : ℂ) * Complex.I)
        * Complex.exp (((∑ A : H, ((A : {A : Set Ω // MeasurableSet[𝒢₀] A}) : Set Ω).indicator
            (fun _ => (1 : ℝ)) ω * u A : ℝ) : ℂ) * Complex.I) * Z ω ∂P = 0) :
    Z =ᵐ[P] 0 := by
  obtain ⟨Z₁, hZ₁m, hZZ₁⟩ := hZm
  have hZ₁m' : StronglyMeasurable[aug (D.jointWindowSigma T ⊔ 𝒢₀) mΩ P] Z₁ :=
    hZ₁m.mono (aug_le_of_le_aug (filtration_sup_le_aug_jointWindowSigma D h𝒢₀ T))
  obtain ⟨Y, hYm, hZ₁Y⟩ := aestronglyMeasurable_of_stronglyMeasurable_aug hZ₁m'
  have hZY : Z =ᵐ[P] Y := hZZ₁.trans hZ₁Y
  refine hZY.trans (ae_eq_zero_of_integral_char_cylinder_eq_zero (Y := enlFamily 𝒢₀ D T)
    (measurable_enlFamily D h𝒢₀ T) (sup_le (D.jointWindowSigma_le T) h𝒢₀)
    (iSup_comap_enlFamily D T) (hZ.congr hZY) hYm fun F w => ?_)
  refine Eq.trans ?_ (h F.toLeft.toLeft F.toLeft.toRight F.toRight
    (fun p => extendZero F w (Sum.inl (Sum.inl p)))
    (fun B => extendZero F w (Sum.inl (Sum.inr B))) (fun A => extendZero F w (Sum.inr A)))
  refine integral_congr_ae ?_
  filter_upwards [hZY] with ω hω
  have hw : ∀ i : F, (⟪enlFamily 𝒢₀ D T i ω, w i⟫ : ℝ) = enlFamily 𝒢₀ D T i ω * w i :=
    fun i => by simp [RCLike.inner_apply, mul_comm]
  simp only [hw]
  rw [sum_enlFamily_eq D T F w ω, Complex.ofReal_add, Complex.ofReal_add, add_mul, add_mul,
    Complex.exp_add, Complex.exp_add, hω]

end Dissertation.WellPosedness.Enlarged
