import Dissertation.WellPosedness.Enlarged.Filtration
import LevyStochCalc.Driver.AugJointRightCont

/-!
# The Lévy driver over the initially enlarged filtration

Let `D` be a Lévy driver with joint natural filtration `ℱ`, and let `𝒢₀` be independent of the
σ-algebra `⨆ t, ℱ_t` generated by the whole joint filtration. Then every coordinate `Wʲ` and
every unit combination `∑ cᵢ Wⁱ` of the Brownian motion is a Brownian motion, and the Poisson
random measure `N` is a Poisson random measure, for the initially enlarged filtration
`t ↦ ℱ_t ⊔ 𝒢₀` and for its usual augmentation `enlJoint 𝒢₀ D h𝒢₀`.

The step from `ℱ` to `t ↦ ℱ_t ⊔ 𝒢₀` is generic: if `W` is a Brownian motion (or `N` a Poisson
random measure) for a filtration `𝒜`, and `𝒢₀` is independent of a σ-algebra `𝒟` containing
every `𝒜_s` and every increment of `W` (or every count of `N`), then `W` is one (or `N` is one)
for `t ↦ 𝒜_t ⊔ 𝒢₀`; for `𝒟 = ⨆ t, ℱ_t` this uses that `⨆ t, ℱ_t` contains `σ(Wⁱ)` for every
`i` and `σ(N)`, the count of `N` on a measurable region `B` being the increasing limit of its
counts on `B ∩ ((-∞, n] × E)`. The step to `enlJoint 𝒢₀ D h𝒢₀` is the passage to the
right-continuous version and then to the augmentation.

## Main statements

* `isBrownianFiltration_sup_const`, `isPoissonFiltration_sup_const` — joining a filtration with
  a constant σ-algebra independent of the noise.
* `iSup_sigma_le_iSup_filtration` — `(⨆ i, σ(Wⁱ)) ⊔ σ(N) ≤ ⨆ t, ℱ_t`.
* `isBrownianFiltration_enlJoint`, `isBrownianFiltration_combineBM_enlJoint`,
  `isPoissonFiltration_enlJoint` — the driver over the enlarged filtration.
-/

open MeasureTheory ProbabilityTheory

namespace Dissertation.WellPosedness.Enlarged

open LevyStochCalc

universe u v w

section Generic

variable {Ω : Type u} {𝒢₀ 𝒟 : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
  [IsProbabilityMeasure P] {ℱ : MeasureTheory.Filtration ℝ mΩ}

/-- A Brownian motion for a filtration `ℱ` is one for `t ↦ ℱ_t ⊔ 𝒢₀` when `𝒢₀` is independent
of a σ-algebra containing every `ℱ_s` and every increment of the Brownian motion. -/
theorem isBrownianFiltration_sup_const {W : Brownian.BrownianMotion P}
    (h : Brownian.IsBrownianFiltration W ℱ) (h𝒢₀ : 𝒢₀ ≤ mΩ) (hℱ : ∀ s, ℱ s ≤ 𝒟)
    (hW : ∀ s t, MeasurableSpace.comap (fun ω => W.W t ω - W.W s ω) inferInstance ≤ 𝒟)
    (hind : Indep 𝒢₀ 𝒟 P) :
    Brownian.IsBrownianFiltration W (ℱ ⊔ MeasureTheory.Filtration.const ℝ 𝒢₀ h𝒢₀) :=
  h.of_le_sup (fun t => (h.measurable t).mono (le_sup_left : ℱ t ≤ ℱ t ⊔ 𝒢₀) le_rfl)
    (m := fun _ => 𝒢₀) (fun _ => h𝒢₀) (fun _ => le_rfl)
    (fun s _ => indep_of_indep_of_le_right hind (sup_le (hℱ s) (iSup₂_le fun t _ => hW s t)))

/-- A Poisson random measure for a filtration `ℱ` is one for `t ↦ ℱ_t ⊔ 𝒢₀` when `𝒢₀` is
independent of a σ-algebra containing every `ℱ_s` and every count of the random measure. -/
theorem isPoissonFiltration_sup_const {E : Type v} [MeasurableSpace E] {ν : Measure E}
    [SigmaFinite ν] {N : Poisson.PoissonRandomMeasure.{u, v, w} P ν}
    (h : Poisson.IsPoissonFiltration N ℱ) (h𝒢₀ : 𝒢₀ ≤ mΩ) (hℱ : ∀ s, ℱ s ≤ 𝒟)
    (hN : ∀ B : Set (ℝ × E), MeasurableSet B →
      MeasurableSpace.comap (fun ω => N.N ω B) inferInstance ≤ 𝒟)
    (hind : Indep 𝒢₀ 𝒟 P) :
    Poisson.IsPoissonFiltration N (ℱ ⊔ MeasureTheory.Filtration.const ℝ 𝒢₀ h𝒢₀) where
  measurable t _ hB hBm := (h.measurable hB hBm).mono (le_sup_left : ℱ t ≤ ℱ t ⊔ 𝒢₀) le_rfl
  indep_future s hs := by
    have hfut : (⨆ B ∈ {B : Set (ℝ × E) | B ⊆ Set.Ioi s ×ˢ Set.univ ∧ MeasurableSet B},
        MeasurableSpace.comap (fun ω => N.N ω B) inferInstance) ≤ mΩ :=
      iSup₂_le fun B hB => (N.measurable_eval hB.2).comap_le
    exact Probability.indep_sup_left_of_indep (ℱ.le s) h𝒢₀ hfut (h.indep_future hs)
      (indep_of_indep_of_le_right hind (sup_le (hℱ s) (iSup₂_le fun B hB => hN B hB.2)))

end Generic

variable {Ω : Type u} {𝒢₀ : MeasurableSpace Ω} [mΩ : MeasurableSpace Ω] {E : Type v}
  [MeasurableSpace E] {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]
  {d : ℕ}

variable (D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν)

/-- The σ-algebra generated by the whole joint filtration of a Lévy driver contains the
σ-algebra of every Brownian coordinate and that of the Poisson random measure. -/
theorem iSup_sigma_le_iSup_filtration :
    (⨆ i, Brownian.sigmaBrownian (D.W.W i)) ⊔ Driver.sigmaPoisson D.N
      ≤ ⨆ t, D.filtration t := by
  refine sup_le (iSup_le fun i => iSup_le fun t => ?_) (iSup₂_le fun B hB => ?_)
  · exact (D.comap_eval_le_filtration i le_rfl).trans (le_iSup (fun t => D.filtration t) t)
  · have hB' : MeasurableSet B := hB
    have hcut : ∀ n : ℕ, MeasurableSet (B ∩ Set.Iic (n : ℝ) ×ˢ Set.univ) := fun n =>
      hB'.inter (measurableSet_Iic.prod MeasurableSet.univ)
    have hmono : Monotone fun n : ℕ => B ∩ Set.Iic (n : ℝ) ×ˢ Set.univ := by
      intro a b hab
      refine Set.inter_subset_inter_right _ (Set.prod_mono (Set.Iic_subset_Iic.2 ?_) le_rfl)
      exact_mod_cast hab
    have hunion : ⋃ n : ℕ, B ∩ Set.Iic (n : ℝ) ×ˢ Set.univ = B := by
      refine Set.Subset.antisymm (Set.iUnion_subset fun _ => Set.inter_subset_left)
        fun x hx => ?_
      obtain ⟨n, hn⟩ := exists_nat_ge x.1
      exact Set.mem_iUnion.2 ⟨n, hx, Set.mem_Iic.2 hn, Set.mem_univ _⟩
    have heq : (fun ω => D.N.N ω B)
        = fun ω => ⨆ n : ℕ, D.N.N ω (B ∩ Set.Iic (n : ℝ) ×ˢ Set.univ) := by
      funext ω
      rw [← hmono.measure_iUnion, hunion]
    refine Measurable.comap_le ?_
    rw [heq]
    refine Measurable.iSup fun n => ?_
    exact (D.isPoissonFiltration.measurable (t := (n : ℝ)) Set.inter_subset_right
      (hcut n)).mono (le_iSup (fun t => D.filtration t) (n : ℝ)) le_rfl

variable (h𝒢₀ : 𝒢₀ ≤ mΩ) (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P)

include hind₀ in
/-- Every coordinate of the Brownian motion is a Brownian motion for the initially enlarged
joint filtration. -/
theorem isBrownianFiltration_initJoint (j : Fin d) :
    Brownian.IsBrownianFiltration (D.W.W j) (initJoint 𝒢₀ D h𝒢₀) :=
  isBrownianFiltration_sup_const (D.isBrownianFiltration j) h𝒢₀
    (fun s => le_iSup (fun t => D.filtration t) s)
    (fun s t => (Brownian.comap_increment_le_sigmaBrownian (D.W.W j) s t).trans
      ((le_iSup (fun i => Brownian.sigmaBrownian (D.W.W i)) j).trans
        (le_sup_left.trans (iSup_sigma_le_iSup_filtration D))))
    hind₀

include hind₀ in
/-- Every unit combination of the Brownian coordinates is a Brownian motion for the initially
enlarged joint filtration. -/
theorem isBrownianFiltration_combineBM_initJoint {c : Fin d → ℝ} (hc : ∑ i, c i ^ 2 = 1) :
    Brownian.IsBrownianFiltration (Brownian.Multidim.MultidimBrownianMotion.combineBM D.W hc)
      (initJoint 𝒢₀ D h𝒢₀) :=
  isBrownianFiltration_sup_const (D.isBrownianFiltration_combineBM hc) h𝒢₀
    (fun s => le_iSup (fun t => D.filtration t) s)
    (fun s t => (Brownian.Multidim.MultidimBrownianMotion.comap_combine_sub_le D.W c s t).trans
      (iSup_le fun i => (Brownian.comap_increment_le_sigmaBrownian (D.W.W i) s t).trans
        ((le_iSup (fun i => Brownian.sigmaBrownian (D.W.W i)) i).trans
          (le_sup_left.trans (iSup_sigma_le_iSup_filtration D)))))
    hind₀

include hind₀ in
/-- The Poisson random measure is one for the initially enlarged joint filtration. -/
theorem isPoissonFiltration_initJoint :
    Poisson.IsPoissonFiltration D.N (initJoint 𝒢₀ D h𝒢₀) :=
  isPoissonFiltration_sup_const D.isPoissonFiltration h𝒢₀
    (fun s => le_iSup (fun t => D.filtration t) s)
    (fun _ hB => (Driver.comap_count_le_sigmaPoisson D.N hB).trans
      (le_sup_right.trans (iSup_sigma_le_iSup_filtration D)))
    hind₀

include hind₀ in
/-- Every coordinate of the Brownian motion is a Brownian motion for the enlarged filtration. -/
theorem isBrownianFiltration_enlJoint (j : Fin d) :
    Brownian.IsBrownianFiltration (D.W.W j) (enlJoint 𝒢₀ D h𝒢₀) :=
  Brownian.isBrownianFiltration_augFiltration
    (isBrownianFiltration_initJoint D h𝒢₀ hind₀ j).rightCont

include hind₀ in
/-- Every unit combination of the Brownian coordinates is a Brownian motion for the enlarged
filtration. -/
theorem isBrownianFiltration_combineBM_enlJoint {c : Fin d → ℝ} (hc : ∑ i, c i ^ 2 = 1) :
    Brownian.IsBrownianFiltration (Brownian.Multidim.MultidimBrownianMotion.combineBM D.W hc)
      (enlJoint 𝒢₀ D h𝒢₀) :=
  Brownian.isBrownianFiltration_augFiltration
    (isBrownianFiltration_combineBM_initJoint D h𝒢₀ hind₀ hc).rightCont

include hind₀ in
/-- The Poisson random measure is one for the enlarged filtration. -/
theorem isPoissonFiltration_enlJoint : Poisson.IsPoissonFiltration D.N (enlJoint 𝒢₀ D h𝒢₀) :=
  Poisson.isPoissonFiltration_augFiltration
    (isPoissonFiltration_initJoint D h𝒢₀ hind₀).rightCont

end Dissertation.WellPosedness.Enlarged
