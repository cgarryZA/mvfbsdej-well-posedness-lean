import Dissertation.WellPosedness.Existence.ForcingAlgebra
import Dissertation.WellPosedness.System.CrossEval

/-!
# The coefficient processes along a solution at `λ ≠ 0`

In the continuation step of the existence proof of the well-posedness paper, a solution `Θ` of
the `λ`-forced system (4.1) generates the forcing

`Ψ(Θ) = (b(s, Θ_s, μ_s), σ(s, Θ_s, μ_s), h(s, Θ_s, ·, μ_s), f(s, Θ_s, μ_s), g(X_T, Law X_T))`,

the coefficient processes along `Θ`, with a representative `γ` of the jump coefficient. For
`λ ≠ 0` it is a forcing, without any condition on the coefficients beyond the Borel measurability
of `g` in the state: the integrands `λ ψ + q^ψ` of the equations of `Θ` are jointly and
progressively measurable and square integrable, and so are the `q^ψ`, hence so is
`ψ = λ⁻¹ ((λ ψ + q^ψ) − q^ψ)`; likewise the terminal value `λ g + q^g` and `q^g` are square
integrable. So the forcing generated by a solution at `λ ≠ 0` needs neither Lemma A.1 nor
Assumption 2.2: its regularity is that of the integrands, which are fields of the solution
predicate `SolvesForced` and which for `λ ≠ 0` carry the measurability (2.5) and the square
integrability of the coefficient processes.

## Main statements

* `measurable_of_mul_add`, `progressivelyMeasurable_of_mul_add`, `energy_ne_top_of_mul_add` —
  the regularity of `A` from that of `λ A + q` and `q`, for `λ ≠ 0`.
* `measurable_marked_of_mul_add`, `markedProgressivelyMeasurable_of_mul_add`,
  `markedEnergy_ne_top_of_mul_add` — the same for marked processes.
* `SolvesForced.forcing_coeff` — for `λ ≠ 0` the coefficient processes along a solution form a
  forcing.
-/

open MeasureTheory Filter
open scoped ENNReal

namespace Dissertation.WellPosedness.Existence

open Dissertation.WellPosedness.Stability Dissertation.WellPosedness.System LevyStochCalc

universe u v w

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E] {P : Measure Ω}
  {ν : Measure E} {T l : ℝ}

/-! ### Dividing out a nonzero scalar -/

section Unmarked

variable {A q : Ω → ℝ → ℝ}

/-- For `λ ≠ 0`, `A` is jointly measurable when `λ A + q` and `q` are. -/
theorem measurable_of_mul_add (hl : l ≠ 0)
    (h : Measurable (Function.uncurry fun ω s => l * A ω s + q ω s))
    (hq : Measurable (Function.uncurry q)) : Measurable (Function.uncurry A) := by
  have e : Function.uncurry A
      = fun p => l⁻¹ * (Function.uncurry (fun ω s => l * A ω s + q ω s) p
        - Function.uncurry q p) := by
    funext p
    exact eq_inv_mul_add_sub hl _ _
  rw [e]
  exact (h.sub hq).const_mul _

/-- For `λ ≠ 0`, `A` is progressively measurable when `λ A + q` and `q` are. -/
theorem progressivelyMeasurable_of_mul_add {ℱ : Filtration ℝ ‹MeasurableSpace Ω›} (hl : l ≠ 0)
    (h : Probability.ProgressivelyMeasurable ℱ fun ω s => l * A ω s + q ω s)
    (hq : Probability.ProgressivelyMeasurable ℱ q) :
    Probability.ProgressivelyMeasurable ℱ A := by
  have e : A = fun ω s => l⁻¹ * ((l * A ω s + q ω s) - q ω s) := by
    funext ω s
    exact eq_inv_mul_add_sub hl _ _
  rw [e]
  exact (continuous_const_mul l⁻¹).comp_progressivelyMeasurable (mul_zero _) (h.sub hq)

/-- For `λ ≠ 0`, `A` has finite energy on `[0, T]` when `λ A + q` and `q` are jointly measurable
with finite energy on it. -/
theorem energy_ne_top_of_mul_add (hl : l ≠ 0)
    (hm : Measurable (Function.uncurry fun ω s => l * A ω s + q ω s))
    (hqm : Measurable (Function.uncurry q))
    (h : Brownian.Ito.energy P T (fun ω s => l * A ω s + q ω s) ≠ ⊤)
    (hq : Brownian.Ito.energy P T q ≠ ⊤) : Brownian.Ito.energy P T A ≠ ⊤ := by
  have e : A = fun ω s => l⁻¹ * ((l * A ω s + q ω s) - q ω s) := by
    funext ω s
    exact eq_inv_mul_add_sub hl _ _
  rw [e, energy_const_mul]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top (BSDEJ.Solves.energy_sub_ne_top hm hqm h hq)

end Unmarked

section Marked

variable {A q : ℝ → Ω → E → ℝ}

/-- For `λ ≠ 0`, the marked process `A` is jointly measurable when `λ A + q` and `q` are. -/
theorem measurable_marked_of_mul_add (hl : l ≠ 0)
    (h : Measurable fun p : Ω × ℝ × E => l * A p.2.1 p.1 p.2.2 + q p.2.1 p.1 p.2.2)
    (hq : Measurable fun p : Ω × ℝ × E => q p.2.1 p.1 p.2.2) :
    Measurable fun p : Ω × ℝ × E => A p.2.1 p.1 p.2.2 := by
  have e : (fun p : Ω × ℝ × E => A p.2.1 p.1 p.2.2) = fun p : Ω × ℝ × E =>
      l⁻¹ * ((l * A p.2.1 p.1 p.2.2 + q p.2.1 p.1 p.2.2) - q p.2.1 p.1 p.2.2) := by
    funext p
    exact eq_inv_mul_add_sub hl _ _
  rw [e]
  exact (h.sub hq).const_mul _

/-- For `λ ≠ 0`, the marked process `A` is marked progressively measurable when `λ A + q` and `q`
are. -/
theorem markedProgressivelyMeasurable_of_mul_add {ℱ : Filtration ℝ ‹MeasurableSpace Ω›}
    (hl : l ≠ 0)
    (h : Probability.MarkedProgressivelyMeasurable ℱ fun ω s e => l * A s ω e + q s ω e)
    (hq : Probability.MarkedProgressivelyMeasurable ℱ fun ω s e => q s ω e) :
    Probability.MarkedProgressivelyMeasurable ℱ fun ω s e => A s ω e := by
  have e : (fun ω s e => A s ω e)
      = fun ω s e => l⁻¹ * ((l * A s ω e + q s ω e) + -1 * q s ω e) := by
    funext ω s e
    rw [neg_one_mul, ← sub_eq_add_neg]
    exact eq_inv_mul_add_sub hl _ _
  rw [e]
  exact Poisson.Compensated.markedProgressivelyMeasurable_const_mul
    (Poisson.Compensated.markedProgressivelyMeasurable_add h
      (Poisson.Compensated.markedProgressivelyMeasurable_const_mul hq (-1))) _

/-- For `λ ≠ 0`, the marked process `A` has finite marked energy on `[0, T]` when `λ A + q` and
`q` are jointly measurable with finite marked energy on it. -/
theorem markedEnergy_ne_top_of_mul_add [SigmaFinite ν] (hl : l ≠ 0)
    (hm : Measurable fun p : Ω × ℝ × E => l * A p.2.1 p.1 p.2.2 + q p.2.1 p.1 p.2.2)
    (hqm : Measurable fun p : Ω × ℝ × E => q p.2.1 p.1 p.2.2)
    (h : Poisson.Compensated.markedEnergy P ν T (fun ω s e => l * A s ω e + q s ω e) ≠ ⊤)
    (hq : Poisson.Compensated.markedEnergy P ν T (fun ω s e => q s ω e) ≠ ⊤) :
    Poisson.Compensated.markedEnergy P ν T (fun ω s e => A s ω e) ≠ ⊤ := by
  have e : (fun ω s e => A s ω e)
      = fun ω s e => l⁻¹ * ((l * A s ω e + q s ω e) + -1 * q s ω e) := by
    funext ω s e
    rw [neg_one_mul, ← sub_eq_add_neg]
    exact eq_inv_mul_add_sub hl _ _
  rw [e, markedEnergy_const_mul]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (Poisson.Compensated.markedEnergy_add_ne_top hm (hqm.const_mul (-1)) h
      (Poisson.Compensated.markedEnergy_const_mul_ne_top hqm hq (-1)))

end Marked

/-! ### The coefficient processes along a solution -/

variable [IsProbabilityMeasure P] [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]
  {n m d : ℕ} {D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν}
  {ℱ : Filtration ℝ ‹MeasurableSpace Ω›}
  {hℱW : ∀ j : Fin d, LevyStochCalc.Brownian.IsBrownianFiltration (D.W.W j) ℱ}
  {hℱN : LevyStochCalc.Poisson.IsPoissonFiltration D.N ℱ} {lam : ℝ} {C : Coeffs ν n m d}
  {ξ₀ : Fin n → Ω → ℝ}
  {qb : Fin n → Ω → ℝ → ℝ} {qσ : Fin n → ℝ → Ω → Fin d → ℝ} {qh : Fin n → ℝ → Ω → E → ℝ}
  {qf : Fin m → Ω → ℝ → ℝ} {qg : Fin m → Ω → ℝ}
  {X : Fin n → ℝ → Ω → ℝ} {Y : Fin m → ℝ → Ω → ℝ}
  {Z : Fin m → ℝ → Ω → Fin d → ℝ} {U : Fin m → ℝ → Ω → E → ℝ} {γ : Fin n → ℝ → Ω → E → ℝ}

/-- **For `λ ≠ 0` the coefficient processes along a solution form a forcing**: if
`(X, Y, Z, U)` solves the `λ`-forced system (4.1) with jump representative `γ`, `λ ≠ 0`, and `g`
is Borel measurable in the state, then
`(b(s, Θ_s, μ_s), σ(s, Θ_s, μ_s), γ, f(s, Θ_s, μ_s), g(X_T, Law X_T))`, each process extended by
`0` off `[0, T]`, is a forcing. -/
theorem _root_.Dissertation.WellPosedness.System.SolvesForced.forcing_coeff
    (h : SolvesForced D ℱ hℱW hℱN T lam C ξ₀ qb qσ qh qf qg X Y Z U γ) (hlam : lam ≠ 0)
    (hg : ∀ ρ, Measurable fun x => C.g x ρ) :
    Forcing ℱ P ν T (driftProc P T C X Y Z U) (diffusionProc P T C X Y Z U) (jumpProc T γ)
      (driverProc P T C X Y Z U) (terminalVal P T C X) where
  qb_meas i := measurable_of_mul_add hlam (h.fwd i).b_meas (h.forcing.qb_meas i)
  qb_prog i := progressivelyMeasurable_of_mul_add hlam (h.fwd i).b_prog (h.forcing.qb_prog i)
  qb_vanish i ω s hs := by simp [driftProc, Set.indicator_of_notMem hs]
  qb_sq i := energy_ne_top_of_mul_add hlam (h.fwd i).b_meas (h.forcing.qb_meas i)
    (h.fwd i).b_sq (h.forcing.qb_sq i)
  qσ_meas i j := measurable_of_mul_add (A := fun ω s => diffusionProc P T C X Y Z U i s ω j)
    (q := fun ω s => qσ i s ω j) hlam ((h.fwd i).σ_meas j) (h.forcing.qσ_meas i j)
  qσ_prog i j := progressivelyMeasurable_of_mul_add
    (A := fun ω s => diffusionProc P T C X Y Z U i s ω j) (q := fun ω s => qσ i s ω j) hlam
    ((h.fwd i).σ_prog j) (h.forcing.qσ_prog i j)
  qσ_vanish i ω s hs := by
    funext j
    simp [diffusionProc, Set.indicator_of_notMem hs]
  qσ_sq i j := energy_ne_top_of_mul_add (A := fun ω s => diffusionProc P T C X Y Z U i s ω j)
    (q := fun ω s => qσ i s ω j) hlam ((h.fwd i).σ_meas j) (h.forcing.qσ_meas i j)
    ((h.fwd i).σ_sq j) (h.forcing.qσ_sq i j)
  qh_meas i := measurable_marked_of_mul_add (A := jumpProc T γ i) (q := qh i) hlam
    (h.fwd i).γ_meas (h.forcing.qh_meas i)
  qh_prog i := markedProgressivelyMeasurable_of_mul_add (A := jumpProc T γ i) (q := qh i) hlam
    (h.fwd i).γ_prog (h.forcing.qh_prog i)
  qh_vanish i ω s e hs := by simp [jumpProc, Set.indicator_of_notMem hs]
  qh_sq i := markedEnergy_ne_top_of_mul_add (A := jumpProc T γ i) (q := qh i) hlam
    (h.fwd i).γ_meas (h.forcing.qh_meas i) (h.fwd i).γ_sq (h.forcing.qh_sq i)
  qf_meas k := measurable_of_mul_add hlam (h.bwd k).φ_meas (h.forcing.qf_meas k)
  qf_prog k := progressivelyMeasurable_of_mul_add hlam (h.bwd k).φ_prog (h.forcing.qf_prog k)
  qf_vanish k ω s hs := by simp [driverProc, Set.indicator_of_notMem hs]
  qf_sq k := energy_ne_top_of_mul_add hlam (h.bwd k).φ_meas (h.forcing.qf_meas k)
    (h.bwd k).φ_sq (h.forcing.qf_sq k)
  qg_meas k := stronglyMeasurable_terminalVal hg (fun i => (h.fwd i).X_adapted T) k
  qg_sq k := by
    have e : terminalVal P T C X k
        = fun ω => lam⁻¹ * ((lam * terminalVal P T C X k ω + qg k ω) - qg k ω) := by
      funext ω
      exact eq_inv_mul_add_sub hlam _ _
    rw [e]
    exact ((h.bwd k).ξ_sq.sub (h.forcing.qg_sq k)).const_mul _

end Dissertation.WellPosedness.Existence
