/-!
# The predictable left-limit tuple

Under the hypotheses of Lemma A.1 of the well-posedness paper — `X, Y` càdlàg and adapted, `Z, U`
predictable, all of finite energy on `[0, T]` — the left-limit tuple `Θ⁻ = (X₋, Y₋, Z, U)` is a
predictable field in the tuple space `H`.

* **Left limits.** `X_{s−}` is the limit of the values of `X` at the dyadic grid points strictly
  below `s`, each known before `s`, so `X₋` is predictable. A càdlàg path jumps at countably many
  times, so on every path `X₋ = X` off a Lebesgue-null set of times; hence `X₋ = X`
  `dt ⊗ dP`-almost everywhere and `X₋` has the energy of `X`.
* **The jump channel.** The marked predictable σ-algebra is generated by the rectangles
  `F × (r, q] × B` with `F` known at `r`, each the image of the product of the predictable
  rectangle `(r, q] × F` and the mark set `B`. A marked predictable process is therefore
  measurable for the product of the predictable σ-algebra and the σ-algebra of the marks, and
  the `L²(ν)` class of `U_t(ω, ·)` is a predictable, strongly measurable `L²(ν)`-valued map. It
  is the class of `U_t(ω, ·)` wherever that is square integrable, `dt ⊗ dP`-almost everywhere on
  `[0, T] × Ω`, and it is square integrable on `[0, T] × Ω`.

## Main statements

* `predictable_leftLimProc` — the left limits of an adapted process with left limits are
  predictable.
* `measurable_markedPredictable_comp_swap` — a marked predictable process is measurable for the
  product of the predictable σ-algebra and the σ-algebra of the marks.
* `predictable_uLift_of_markedPredictable` — the `L²(ν)` class of a marked predictable process
  is predictable.
* `CadlagPredTuple.countable_setOf_leftLimProc_X_ne`, `CadlagPredTuple.ae_leftLimProc_eq`,
  `CadlagPredTuple.energy_leftLimProc_X` — the left limits agree with the process off a
  countable set of times on every path, `dt ⊗ dP`-almost everywhere, and in energy.
* `CadlagPredTuple.memLp_U`, `CadlagPredTuple.memLp_uLift`, `CadlagPredTuple.ae_coeFn_uLift` —
  the jump channel in `L²([0, T] × Ω × E)` and its `L²(ν)`-valued representative.
* `CadlagPredTuple.predictable_toL2_tupleAt_leftLim` — `Θ⁻` is predictable.
-/

open MeasureTheory Filter Topology LevyStochCalc.Probability
open scoped ENNReal

namespace Dissertation.WellPosedness.System

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E] {ν : Measure E}

/-! ### Predictability -/

section Predictability

/-- **The left limits of an adapted process with left limits are predictable**: `s ↦ X_{s−}` is
the pointwise limit of the values of `X` at the dyadic grid points strictly below `s`. -/
theorem predictable_leftLimProc {ι : Type*} {ℱ : Filtration ℝ mΩ} {X : ι → ℝ → Ω → ℝ} {i : ι}
    (hX : Adapted ℱ (X i))
    (hleft : ∀ ω t, ∃ L : ℝ, Tendsto (fun s => X i s ω) (𝓝[<] t) (𝓝 L)) :
    Predictable ℱ fun ω s => leftLimProc X i s ω := by
  have hm : Measurable[predictableSigma ℱ] fun p : ℝ × Ω => leftLimProc X i p.1 p.2 :=
    measurable_predictableSigma_of_tendsto_leftGridPoint (Z := X i)
      (Y := fun s ω => leftLimProc X i s ω) (fun t => hX t) fun s ω => by
        obtain ⟨L, hL⟩ := hleft ω s
        rw [leftLimProc, leftLim_eq_of_tendsto hL]
        exact hL.comp (tendsto_leftGridPoint s)
  exact hm.stronglyMeasurable

/-- **A marked predictable set, read on `(ℝ × Ω) × E`, is measurable for the product of the
predictable σ-algebra and the σ-algebra of the marks**: the reordering
`((t, ω), e) ↦ (ω, t, e)` is measurable from that product to the marked predictable σ-algebra. -/
theorem measurable_swap_markedPredictableSigma (ℱ : Filtration ℝ mΩ) (ν : Measure E) :
    @Measurable ((ℝ × Ω) × E) (Ω × ℝ × E) (@Prod.instMeasurableSpace _ _ (predictableSigma ℱ) _)
      (markedPredictableSigma ℱ ν) fun q => (q.1.2, q.1.1, q.2) := by
  letI : MeasurableSpace (ℝ × Ω) := predictableSigma ℱ
  refine measurable_generateFrom ?_
  rintro _ ⟨r, q, F, B, -, hF, hB, -, rfl⟩
  have hpre : (fun q : (ℝ × Ω) × E => (q.1.2, q.1.1, q.2)) ⁻¹' (F ×ˢ (Set.Ioc r q ×ˢ B))
      = (Set.Ioc r q ×ˢ F) ×ˢ B := by
    ext ⟨⟨s, ω⟩, e⟩
    simp only [Set.mem_preimage, Set.mem_prod]
    tauto
  rw [hpre]
  rcases le_or_gt r q with hrq | hrq
  · exact (measurableSet_predictableSigma_Ioc_prod hrq hF).prod hB
  · rw [Set.Ioc_eq_empty (not_lt.mpr hrq.le), Set.empty_prod, Set.empty_prod]
    exact MeasurableSet.empty

/-- **A marked predictable process is measurable for the product of the predictable σ-algebra
and the σ-algebra of the marks.** -/
theorem measurable_markedPredictable_comp_swap {ℱ : Filtration ℝ mΩ} {F : Type*}
    [MeasurableSpace F] {ψ : Ω → ℝ → E → F} (hψ : MarkedPredictable ℱ ν ψ) :
    @Measurable ((ℝ × Ω) × E) F (@Prod.instMeasurableSpace _ _ (predictableSigma ℱ) _) _
      fun q => ψ q.1.2 q.1.1 q.2 :=
  hψ.comp (measurable_swap_markedPredictableSigma ℱ ν)

variable [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]

/-- **The `L²(ν)` class of a marked predictable process is predictable**: for coordinates `U_k`
marked predictable for `ℱ`, `(t, ω) ↦ [e ↦ (U_{k,t}(ω, e))_k] ∈ L²(ν; ℝᵐ)` (`0` where the
section is not square integrable) is strongly measurable for the predictable σ-algebra. -/
theorem predictable_uLift_of_markedPredictable {ℱ : Filtration ℝ mΩ} {m : ℕ}
    {U : Fin m → ℝ → Ω → E → ℝ} (hU : ∀ k, MarkedPredictable ℱ ν fun ω s e => U k s ω e) :
    Predictable ℱ fun ω s => uLift ν fun e k => U k s ω e := by
  have hk : ∀ k, @Measurable ((ℝ × Ω) × E) ℝ
      (@Prod.instMeasurableSpace _ _ (predictableSigma ℱ) _) _
      fun q => U k q.1.1 q.1.2 q.2 := fun k => measurable_markedPredictable_comp_swap (hU k)
  exact stronglyMeasurable_uLift (mΩ := predictableSigma ℱ)
    (u := fun p : ℝ × Ω => fun e k => U k p.1 p.2 e)
    (@measurable_pi_iff ((ℝ × Ω) × E) (Fin m) (fun _ => ℝ)
      (@Prod.instMeasurableSpace _ _ (predictableSigma ℱ) _) _ _ |>.mpr hk)

end Predictability

/-- The integral over `[0, T]` of the indicator of a countable set of times vanishes. -/
theorem lintegral_indicator_countable {T : ℝ} {S : Set ℝ} (hS : S.Countable) :
    ∫⁻ t in Set.Icc (0 : ℝ) T, S.indicator 1 t = 0 := by
  rw [lintegral_indicator_one hS.measurableSet, Measure.restrict_apply hS.measurableSet]
  exact measure_mono_null Set.inter_subset_left (hS.measure_zero volume)

/-! ### Lemma A.1, Step 1 -/

section StepOne

variable [MeasurableSpace Ω] {n m d : ℕ} {ℱ : Filtration ℝ ‹MeasurableSpace Ω›} {P : Measure Ω}
  {T : ℝ} {X : Fin n → ℝ → Ω → ℝ} {Y : Fin m → ℝ → Ω → ℝ} {Z : Fin m → ℝ → Ω → Fin d → ℝ}
  {U : Fin m → ℝ → Ω → E → ℝ}

namespace CadlagPredTuple

variable (hΘ : CadlagPredTuple ℱ P ν T X Y Z U)
include hΘ

/-- Each coordinate of `X₋` is predictable. -/
theorem predictable_leftLimProc_X (i : Fin n) :
    Predictable ℱ fun ω s => leftLimProc X i s ω :=
  predictable_leftLimProc (hΘ.X_adapted i) (hΘ.X_leftLim i)

/-- Each coordinate of `Y₋` is predictable. -/
theorem predictable_leftLimProc_Y (k : Fin m) :
    Predictable ℱ fun ω s => leftLimProc Y k s ω :=
  predictable_leftLimProc (hΘ.Y_adapted k) (hΘ.Y_leftLim k)

/-- **Every path of `X` jumps at countably many times**: `{t : X_{t−}(ω) ≠ X_t(ω)}` is
countable. -/
theorem countable_setOf_leftLimProc_X_ne (i : Fin n) (ω : Ω) :
    {t : ℝ | leftLimProc X i t ω ≠ X i t ω}.Countable := by
  have h := LevyStochCalc.Analysis.countable_setOf_ne_leftLim (hΘ.X_rightCont i ω)
    (hΘ.X_leftLim i ω)
  refine h.mono fun t ht => ?_
  exact Ne.symm ht

/-- **Every path of `Y` jumps at countably many times.** -/
theorem countable_setOf_leftLimProc_Y_ne (k : Fin m) (ω : Ω) :
    {t : ℝ | leftLimProc Y k t ω ≠ Y k t ω}.Countable := by
  have h := LevyStochCalc.Analysis.countable_setOf_ne_leftLim (hΘ.Y_rightCont k ω)
    (hΘ.Y_leftLim k ω)
  refine h.mono fun t ht => ?_
  exact Ne.symm ht

/-- **`X₋ = X` and `Y₋ = Y` `dt ⊗ dP`-almost everywhere** on `[0, T] × Ω`. -/
theorem ae_leftLimProc_eq [IsProbabilityMeasure P] [SigmaFinite ν]
    [MeasurableSpace.CountablyGenerated E] :
    ∀ᵐ p ∂((volume.restrict (Set.Icc (0 : ℝ) T)).prod P),
      (∀ i, leftLimProc X i p.1 p.2 = X i p.1 p.2)
        ∧ ∀ k, leftLimProc Y k p.1 p.2 = Y k p.1 p.2 := by
  filter_upwards [hΘ.ae_toL2_tupleAt_leftLim_eq] with p hp
  have h := congrArg ofL2 hp
  simp only [ofL2_toL2, tupleAt, Prod.mk.injEq] at h
  obtain ⟨h1, h2, -, -⟩ := h
  exact ⟨fun i => by
      simpa using congrArg (fun v : EuclideanSpace ℝ (Fin n) => WithLp.ofLp v i) h1,
    fun k => by simpa using congrArg (fun v : EuclideanSpace ℝ (Fin m) => WithLp.ofLp v k) h2⟩

/-- **`X₋` has the energy of `X`** on `[0, T]`. -/
theorem energy_leftLimProc_X (i : Fin n) :
    LevyStochCalc.Brownian.Ito.energy P T (fun ω s => leftLimProc X i s ω)
      = LevyStochCalc.Brownian.Ito.energy P T (fun ω s => X i s ω) := by
  unfold LevyStochCalc.Brownian.Ito.energy
  refine lintegral_congr fun ω => lintegral_congr_ae (ae_restrict_of_ae ?_)
  filter_upwards [LevyStochCalc.Analysis.ae_eq_leftLim_of_cadlag (hΘ.X_rightCont i ω)
    (hΘ.X_leftLim i ω)] with s hs
  rw [leftLimProc, ← hs]

/-- **`Y₋` has the energy of `Y`** on `[0, T]`. -/
theorem energy_leftLimProc_Y (k : Fin m) :
    LevyStochCalc.Brownian.Ito.energy P T (fun ω s => leftLimProc Y k s ω)
      = LevyStochCalc.Brownian.Ito.energy P T (fun ω s => Y k s ω) := by
  unfold LevyStochCalc.Brownian.Ito.energy
  refine lintegral_congr fun ω => lintegral_congr_ae (ae_restrict_of_ae ?_)
  filter_upwards [LevyStochCalc.Analysis.ae_eq_leftLim_of_cadlag (hΘ.Y_rightCont k ω)
    (hΘ.Y_leftLim k ω)] with s hs
  rw [leftLimProc, ← hs]

/-- The coordinates of `U`, read on `(ℝ × Ω) × E`, are jointly measurable. -/
theorem measurable_U_prod (k : Fin m) :
    Measurable fun q : (ℝ × Ω) × E => U k q.1.1 q.1.2 q.2 :=
  (hΘ.measurable_U k).comp (by fun_prop : Measurable fun q : (ℝ × Ω) × E => (q.1.2, q.1.1, q.2))

/-- The integral over `[0, T] × Ω × E` of the squared coordinates of `U` is the sum of their
marked energies. -/
theorem lintegral_enorm_U_sq [SFinite P] [SFinite ν] :
    ∫⁻ q, ‖(WithLp.toLp 2 fun k => U k q.1.1 q.1.2 q.2 : EuclideanSpace ℝ (Fin m))‖ₑ ^ 2
        ∂(((volume.restrict (Set.Icc (0 : ℝ) T)).prod P).prod ν)
      = ∑ k, LevyStochCalc.Poisson.Compensated.markedEnergy P ν T (fun ω s e => U k s ω e) := by
  have hm : ∀ k, Measurable fun q : (ℝ × Ω) × E => (‖U k q.1.1 q.1.2 q.2‖₊ : ℝ≥0∞) ^ 2 :=
    fun k => (hΘ.measurable_U_prod k).nnnorm.coe_nnreal_ennreal.pow_const 2
  simp only [enorm_toLp_sq]
  rw [lintegral_finsetSum _ fun k _ => hm k]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [lintegral_prod _ (hm k).aemeasurable, lintegral_prod _
    ((hm k).lintegral_prod_right').aemeasurable]
  exact lintegral_lintegral_swap (f := fun s ω => ∫⁻ e, (‖U k s ω e‖₊ : ℝ≥0∞) ^ 2 ∂ν)
    ((hm k).lintegral_prod_right').aemeasurable

/-- **The jump channel lies in `L²([0, T] × Ω × E)`.** -/
theorem memLp_U [SFinite P] [SFinite ν] :
    MemLp (fun q : (ℝ × Ω) × E => (WithLp.toLp 2 fun k => U k q.1.1 q.1.2 q.2 :
        EuclideanSpace ℝ (Fin m))) 2 (((volume.restrict (Set.Icc (0 : ℝ) T)).prod P).prod ν) := by
  have hmv : Measurable fun q : (ℝ × Ω) × E =>
      (WithLp.toLp 2 fun k => U k q.1.1 q.1.2 q.2 : EuclideanSpace ℝ (Fin m)) :=
    (WithLp.measurable_toLp 2 _).comp (measurable_pi_iff.mpr hΘ.measurable_U_prod)
  refine ⟨hmv.aestronglyMeasurable, ?_⟩
  have h2 := eLpNorm_two_sq (ν := ((volume.restrict (Set.Icc (0 : ℝ) T)).prod P).prod ν)
    fun q : (ℝ × Ω) × E => (WithLp.toLp 2 fun k => U k q.1.1 q.1.2 q.2 : EuclideanSpace ℝ (Fin m))
  rw [hΘ.lintegral_enorm_U_sq] at h2
  have hfin : (∑ k, LevyStochCalc.Poisson.Compensated.markedEnergy P ν T
      (fun ω s e => U k s ω e)) < ⊤ := ENNReal.sum_lt_top.mpr fun k _ => (hΘ.U_sq k).lt_top
  rw [lt_top_iff_ne_top]
  intro htop
  rw [htop, ENNReal.top_pow two_ne_zero] at h2
  exact hfin.ne h2.symm

variable [SigmaFinite ν] [MeasurableSpace.CountablyGenerated E]

/-- **The `L²(ν)`-valued jump channel is square integrable** on `[0, T] × Ω`. -/
theorem memLp_uLift [IsProbabilityMeasure P] :
    MemLp (fun p : ℝ × Ω => uLift ν fun e k => U k p.1 p.2 e) 2
      ((volume.restrict (Set.Icc (0 : ℝ) T)).prod P) := by
  have hsm : StronglyMeasurable fun p : ℝ × Ω => uLift ν fun e k => U k p.1 p.2 e :=
    stronglyMeasurable_uLift (u := fun p : ℝ × Ω => fun e k => U k p.1 p.2 e)
      (measurable_pi_iff.mpr hΘ.measurable_U_prod)
  refine hΘ.memLp_toL2_tupleAt.of_le hsm.aestronglyMeasurable (ae_of_all _ fun p => ?_)
  have h4 : ‖(tupleAt ν X Y Z U p.1 p.2).2.2.2‖ ≤ ‖tupleAt ν X Y Z U p.1 p.2‖ :=
    ((norm_snd_le _).trans (norm_snd_le _)).trans (norm_snd_le _)
  exact h4.trans (norm_le_norm_toL2 _)

omit [MeasurableSpace.CountablyGenerated E] in
/-- **The `L²(ν)`-valued jump channel represents `U`**: for `dt ⊗ dP`-almost every
`(t, ω) ∈ [0, T] × Ω`, the class of `e ↦ (U_{k,t}(ω, e))_k` in `L²(ν; ℝᵐ)` is `U_t(ω, ·)`,
`ν`-almost everywhere. -/
theorem ae_coeFn_uLift [IsProbabilityMeasure P] :
    ∀ᵐ p ∂((volume.restrict (Set.Icc (0 : ℝ) T)).prod P),
      (uLift ν (fun e k => U k p.1 p.2 e) : E → EuclideanSpace ℝ (Fin m))
        =ᵐ[ν] fun e => (WithLp.toLp 2 fun k => U k p.1 p.2 e : EuclideanSpace ℝ (Fin m)) := by
  have hint := (memLp_two_iff_integrable_sq_norm hΘ.memLp_U.1).mp hΘ.memLp_U
  filter_upwards [hint.prod_right_ae] with p hp
  have hmp : AEStronglyMeasurable (fun e =>
      (WithLp.toLp 2 fun k => U k p.1 p.2 e : EuclideanSpace ℝ (Fin m))) ν :=
    ((WithLp.measurable_toLp 2 _).comp (measurable_pi_iff.mpr fun k =>
      (hΘ.measurable_U_prod k).comp (measurable_const.prodMk measurable_id))).aestronglyMeasurable
  have hmem : MemLp (fun e =>
      (WithLp.toLp 2 fun k => U k p.1 p.2 e : EuclideanSpace ℝ (Fin m))) 2 ν :=
    (memLp_two_iff_integrable_sq_norm hmp).mpr hp
  rw [uLift_of_memLp hmem]
  exact hmem.coeFn_toLp

/-- **`Θ⁻` is predictable**: `(t, ω) ↦ Θ⁻_t(ω) = (X_{t−}, Y_{t−}, Z_t, U_t)(ω)`, in the tuple space
with its Hilbert norm, is strongly measurable for the predictable σ-algebra. -/
theorem predictable_toL2_tupleAt_leftLim :
    Predictable ℱ fun ω s => toL2 (tupleAt ν (leftLimProc X) (leftLimProc Y) Z U s ω) := by
  letI : MeasurableSpace (ℝ × Ω) := predictableSigma ℱ
  have hX : ∀ i, Measurable fun p : ℝ × Ω => leftLimProc X i p.1 p.2 := fun i =>
    (hΘ.predictable_leftLimProc_X i).measurable
  have hY : ∀ k, Measurable fun p : ℝ × Ω => leftLimProc Y k p.1 p.2 := fun k =>
    (hΘ.predictable_leftLimProc_Y k).measurable
  have hZ : ∀ k j, Measurable fun p : ℝ × Ω => Z k p.1 p.2 j := fun k j =>
    (hΘ.Z_pred k j).measurable
  have hU : StronglyMeasurable fun p : ℝ × Ω => uLift ν fun e k => U k p.1 p.2 e :=
    predictable_uLift_of_markedPredictable hΘ.U_pred
  have hT : Measurable fun p : ℝ × Ω => tupleAt ν (leftLimProc X) (leftLimProc Y) Z U p.1 p.2 :=
    ((WithLp.measurable_toLp 2 _).comp (measurable_pi_iff.mpr hX)).prodMk
      (((WithLp.measurable_toLp 2 _).comp (measurable_pi_iff.mpr hY)).prodMk
        (((WithLp.measurable_toLp 2 _).comp
          (measurable_pi_iff.mpr fun q : Fin m × Fin d => hZ q.1 q.2)).prodMk hU.measurable))
  exact continuous_toL2.comp_stronglyMeasurable hT.stronglyMeasurable

end CadlagPredTuple

end StepOne

end Dissertation.WellPosedness.System
