import Dissertation.WellPosedness.Examples.BrownianFiltration

/-!
# The Brownian forms of the assumptions and of the solution notion in `ℍ²`

Example 5.2 of the well-posedness paper removes the Poisson channel. Inside the paper's model this
is the intensity `ν = 0`: the jump channel `L²(0; ℝᵐ)` of `H` and the fibre `L²(0; ℝⁿ)` of the jump
coefficient are trivial, and `W₂` on `P₂(H)` is `W₂` on the laws of `(X, Y, Z)`
(`Dissertation.WellPosedness.System.w2P_projP2`). This file states, for a coefficient system `C` at
`ν = 0`, Assumptions 2.3 and 2.5 and the solution notion of `ℍ²` of §3 with every term of the jump
channel deleted.

* **Assumption 2.3.** `|δb| + |δσ|_F + |δf| ≤ L (|δX| + |δY| + |δZ|_F + W₂(μ^{XYZ}, μ'^{XYZ}))`
  along the diagonal, with `μ^{XYZ}` the law of `(X, Y, Z)` (`projP2 μ`), and the terminal
  bound (2.6) unchanged.
* **Assumption 2.5.** (2.7) without the jump pairing and without `‖Gᵀ δU‖²`, the terminal
  inequality and the admissible constants unchanged.
* **The solution notion in `ℍ²`.** The equations of (1.1) without the compensated Poisson
  integrals, driven by a `d`-dimensional Brownian motion `W` over a filtration for which each
  coordinate of `W` is a Brownian motion, in `ℍ²` (`BrownianPaperWeakSolution`); the coefficient
  processes are evaluated at `Θ_s = (X_s, Y_s, Z_s, 0)`, the jump channel of `H` being `{0}`.

## Main definitions

* `BrownianLipInteriorAt`, `BrownianLipInterior`, `BrownianAssumption23` — Assumption 2.3 at
  `ν = 0` with the jump terms deleted.
* `brownianPairing`, `BrownianMonoAt`, `BrownianAssumption25` — Assumption 2.5 at `ν = 0` with
  the jump terms deleted.
* `BrownianPaperWeakSolution` — the Brownian forward–backward system in `ℍ²`.

## Main statements

* `isBrownianFiltration_enlBrownian` — at `ν = 0`, each coordinate of the Brownian motion of the
  driver is a Brownian motion for the usual augmentation of the filtration generated by it and
  an independent initial σ-algebra.
-/

open MeasureTheory Filter Topology ProbabilityTheory Dissertation.Law Matrix
open scoped ENNReal NNReal

namespace Dissertation.WellPosedness.Spec

open Dissertation.WellPosedness.System Dissertation.WellPosedness.Existence
  Dissertation.WellPosedness.Enlarged LevyStochCalc LevyStochCalc.BSDEJ.Solves

universe u v w

/-! ### The Brownian filtration -/

/-- **At `ν = 0` the Brownian motion of the driver is one for the enlarged Brownian filtration**:
each of its coordinates is a Brownian motion for `enlBrownian 𝒢₀ D.W h𝒢₀`, the usual augmentation
of the filtration generated by it and `𝒢₀`, when `𝒢₀` is independent of the driver. -/
theorem isBrownianFiltration_enlBrownian {Ω : Type u} {𝒢₀ : MeasurableSpace Ω}
    [mΩ : MeasurableSpace Ω] {P : Measure Ω} [IsProbabilityMeasure P] {E : Type v}
    [MeasurableSpace E] {d : ℕ} (D : Driver.LevyDriver.{u, v, w} P d (0 : Measure E))
    (h𝒢₀ : 𝒢₀ ≤ mΩ) (hind₀ : Indep 𝒢₀ (⨆ t, D.filtration t) P) (j : Fin d) :
    Brownian.IsBrownianFiltration (D.W.W j) (enlBrownian 𝒢₀ D.W h𝒢₀) :=
  enlJoint_nu_zero_eq 𝒢₀ D h𝒢₀ ▸ isBrownianFiltration_enlJoint D h𝒢₀ hind₀ j

variable {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [MeasurableSpace E]
  [MeasurableSpace.CountablyGenerated E] {n m d : ℕ}

/-! ### Assumption 2.3 -/

/-- **The interior bound of Assumption 2.3 at the time `t`, at `ν = 0`, without the jump terms**:
for all `(Θ, μ), (Θ', μ') ∈ 𝒟_t`, almost surely
`|δb| + |δσ|_F + |δf| ≤ L (|δX| + |δY| + |δZ|_F + W₂(μ^{XYZ}, μ'^{XYZ}))`, the coefficients
evaluated at `t` and `μ^{XYZ}` the law of `(X, Y, Z)` in `ℝⁿ × ℝᵐ × ℝ^{m×d}`. -/
def BrownianLipInteriorAt (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (P : Measure Ω)
    [IsProbabilityMeasure P] (t L : ℝ) (C : Coeffs (0 : Measure E) n m d) : Prop :=
  ∀ p ∈ diagonalInputs (0 : Measure E) n m d ℱ P t,
    ∀ p' ∈ diagonalInputs (0 : Measure E) n m d ℱ P t, ∀ᵐ ω ∂P,
      ‖C.b t (p.1 ω) p.2 - C.b t (p'.1 ω) p'.2‖ + ‖C.σ t (p.1 ω) p.2 - C.σ t (p'.1 ω) p'.2‖
          + ‖C.f t (p.1 ω) p.2 - C.f t (p'.1 ω) p'.2‖
        ≤ L * (‖(p.1 ω).1 - (p'.1 ω).1‖ + ‖(p.1 ω).2.1 - (p'.1 ω).2.1‖
          + ‖(p.1 ω).2.2.1 - (p'.1 ω).2.2.1‖ + w2P (projP2 p.2) (projP2 p'.2))

/-- **The interior bound of Assumption 2.3 at `ν = 0` without the jump terms**: for almost every
`t ∈ [0, T]` and all `(Θ, μ), (Θ', μ') ∈ 𝒟_t`, almost surely
`|δb| + |δσ|_F + |δf| ≤ L (|δX| + |δY| + |δZ|_F + W₂(μ^{XYZ}, μ'^{XYZ}))`. -/
def BrownianLipInterior (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (P : Measure Ω)
    [IsProbabilityMeasure P] (T L : ℝ) (C : Coeffs (0 : Measure E) n m d) : Prop :=
  ∀ᵐ t ∂(volume.restrict (Set.Icc (0 : ℝ) T)), BrownianLipInteriorAt ℱ P t L C

/-- **Assumption 2.3 at `ν = 0` without the jump terms**, with the constant `L`: `L ≥ 0`, the
interior bound `BrownianLipInterior` and the terminal bound (2.6). -/
def BrownianAssumption23 (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (P : Measure Ω)
    [IsProbabilityMeasure P] (T L : ℝ) (C : Coeffs (0 : Measure E) n m d) : Prop :=
  0 ≤ L ∧ BrownianLipInterior ℱ P T L C ∧ LipTerminal ℱ P T L C.g

/-! ### Assumption 2.5 -/

/-- **The integrand of the left-hand side of (2.7) without the jump pairing**, at two points
`θ, θ'` of `H` and two laws `μ, μ'` at the time `t`:
`⟨δb, Gᵀ δY⟩ + ⟨δσ, Gᵀ δZ⟩_F + ⟨−δf, G δX⟩`, with `δψ = ψ(t, θ, μ) − ψ(t, θ', μ')` and
`δX, δY, δZ` the channels of `θ − θ'`. -/
noncomputable def brownianPairing (G : Matrix (Fin m) (Fin n) ℝ)
    (C : Coeffs (0 : Measure E) n m d) (t : ℝ) (θ θ' : TupleH (0 : Measure E) n m d)
    (μ μ' : P2 (TupleH (0 : Measure E) n m d)) : ℝ :=
  inner ℝ (C.b t θ μ - C.b t θ' μ') (GX Gᵀ (θ.2.1 - θ'.2.1))
    + inner ℝ (C.σ t θ μ - C.σ t θ' μ') (GZ Gᵀ (θ.2.2.1 - θ'.2.2.1))
    + inner ℝ (-(C.f t θ μ - C.f t θ' μ')) (GX G (θ.1 - θ'.1))

/-- **The interior inequality (2.7) at the time `t`, at `ν = 0`, without the jump terms**: for all
`(Θ, μ), (Θ', μ') ∈ 𝒟_t`, the expectation of the pairing exists and
`𝔼[⟨δb, Gᵀ δY⟩ + ⟨δσ, Gᵀ δZ⟩_F + ⟨−δf, G δX⟩]
  ≤ −β₁ 𝔼[|Gᵀ δY|² + |Gᵀ δZ|²_F] − β₂ 𝔼|G δX|²`, the coefficients evaluated at `t`. -/
def BrownianMonoAt (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (P : Measure Ω)
    [IsProbabilityMeasure P] (t : ℝ) (G : Matrix (Fin m) (Fin n) ℝ) (β₁ β₂ : ℝ)
    (C : Coeffs (0 : Measure E) n m d) : Prop :=
  ∀ p ∈ diagonalInputs (0 : Measure E) n m d ℱ P t,
    ∀ p' ∈ diagonalInputs (0 : Measure E) n m d ℱ P t,
      Integrable (fun ω => brownianPairing G C t (p.1 ω) (p'.1 ω) p.2 p'.2) P
        ∧ ∫ ω, brownianPairing G C t (p.1 ω) (p'.1 ω) p.2 p'.2 ∂P
          ≤ -β₁ * ∫ ω, (‖GX Gᵀ ((p.1 ω).2.1 - (p'.1 ω).2.1)‖ ^ 2
              + ‖GZ Gᵀ ((p.1 ω).2.2.1 - (p'.1 ω).2.2.1)‖ ^ 2) ∂P
            - β₂ * ∫ ω, ‖GX G ((p.1 ω).1 - (p'.1 ω).1)‖ ^ 2 ∂P

/-- **Assumption 2.5 at `ν = 0` without the jump terms**, with the coupling matrix `G` and the
constants `α, β₁, β₂`: the terminal inequality `𝔼⟨δg_T, G δX_T⟩ ≥ α 𝔼|G δX_T|²` for all
`X_T, X'_T ∈ L²(Ω, ℱ_T; ℝⁿ)`, with the expectation of its pairing existing; the interior
inequality `BrownianMonoAt` for almost every `t ∈ [0, T]`; and the admissible constants. -/
def BrownianAssumption25 (ℱ : Filtration ℝ ‹MeasurableSpace Ω›) (P : Measure Ω)
    [IsProbabilityMeasure P] (T : ℝ) (G : Matrix (Fin m) (Fin n) ℝ) (α β₁ β₂ : ℝ)
    (C : Coeffs (0 : Measure E) n m d) : Prop :=
  (∀ XT XT' : Ω → EuclideanSpace ℝ (Fin n), StronglyMeasurable[ℱ T] XT →
    StronglyMeasurable[ℱ T] XT' → MemLp XT 2 P → MemLp XT' 2 P →
    Integrable (fun ω => inner ℝ (C.g (XT ω) (lawP2 P XT) - C.g (XT' ω) (lawP2 P XT'))
        (GX G (XT ω - XT' ω))) P
      ∧ ∫ ω, inner ℝ (C.g (XT ω) (lawP2 P XT) - C.g (XT' ω) (lawP2 P XT'))
          (GX G (XT ω - XT' ω)) ∂P
        ≥ α * ∫ ω, ‖GX G (XT ω - XT' ω)‖ ^ 2 ∂P)
  ∧ (∀ᵐ t ∂(volume.restrict (Set.Icc (0 : ℝ) T)), BrownianMonoAt ℱ P t G β₁ β₂ C)
  ∧ Constants n m α β₁ β₂

/-! ### The solution notion -/

variable {P : Measure Ω} [IsProbabilityMeasure P]

/-- **`(X, Y, Z)` solves the Brownian forward–backward system in `ℍ²`**, with pathwise drift
and driver integrals, coefficients `C` at `ν = 0` and initial datum `ξ₀`, over a filtration `ℱ`
for which each coordinate of the Brownian motion `W` is a Brownian motion:
`PaperWeakSolutionInt` with the jump channel deleted. `X` and `Y` are adapted on `[0, T]` with
right-continuous paths on `[0, T)`, left limits on `(0, T]` almost surely and finite energy on
`[0, T]`; `Z` is predictable with finite energy and vanishes off `[0, T]`; along
`Θ_s = (X_s, Y_s, Z_s, 0)` the drift and driver processes are jointly and progressively
measurable with almost surely integrable paths on `[0, T]` and the diffusion process meets the
conditions for the `L²` Brownian integral to exist; `X_T` is square integrable; and both
identities hold at every `t ∈ [0, T]` on one set of full measure, with càdlàg versions of the
Brownian integrals. -/
structure BrownianPaperWeakSolution (W : Brownian.Multidim.MultidimBrownianMotion P d)
    (ℱ : Filtration ℝ ‹MeasurableSpace Ω›)
    (hℱW : ∀ j : Fin d, Brownian.IsBrownianFiltration (W.W j) ℱ) (T : ℝ)
    (C : Coeffs (0 : Measure E) n m d) (ξ₀ : Fin n → Ω → ℝ) (X : Fin n → ℝ → Ω → ℝ)
    (Y : Fin m → ℝ → Ω → ℝ) (Z : Fin m → ℝ → Ω → Fin d → ℝ) : Prop where
  /-- Each coordinate of `X` is adapted on the horizon. -/
  X_adapted : ∀ i, ∀ t ∈ Set.Icc (0 : ℝ) T, Measurable[ℱ t] (X i t)
  /-- Every path of each coordinate of `X` is right-continuous on `[0, T)`. -/
  X_rightCont : ∀ i ω, ∀ t ∈ Set.Ico (0 : ℝ) T,
    Tendsto (fun s => X i s ω) (𝓝[>] t) (𝓝 (X i t ω))
  /-- Almost every path of each coordinate of `X` has left limits on `(0, T]`. -/
  X_leftLim : ∀ i, ∀ᵐ ω ∂P, ∀ t ∈ Set.Ioc (0 : ℝ) T,
    ∃ L : ℝ, Tendsto (fun s => X i s ω) (𝓝[<] t) (𝓝 L)
  /-- Each coordinate of `X` has finite energy on the horizon, `𝔼 ∫_0^T |X_{i,t}|² dt < ∞`. -/
  X_sq : ∀ i, Brownian.Ito.energy P T (fun ω s => X i s ω) ≠ ⊤
  /-- Each coordinate of `Y` is adapted on the horizon. -/
  Y_adapted : ∀ k, ∀ t ∈ Set.Icc (0 : ℝ) T, Measurable[ℱ t] (Y k t)
  /-- Every path of each coordinate of `Y` is right-continuous on `[0, T)`. -/
  Y_rightCont : ∀ k ω, ∀ t ∈ Set.Ico (0 : ℝ) T,
    Tendsto (fun s => Y k s ω) (𝓝[>] t) (𝓝 (Y k t ω))
  /-- Almost every path of each coordinate of `Y` has left limits on `(0, T]`. -/
  Y_leftLim : ∀ k, ∀ᵐ ω ∂P, ∀ t ∈ Set.Ioc (0 : ℝ) T,
    ∃ L : ℝ, Tendsto (fun s => Y k s ω) (𝓝[<] t) (𝓝 L)
  /-- Each coordinate of `Y` has finite energy on the horizon, `𝔼 ∫_0^T |Y_{k,t}|² dt < ∞`. -/
  Y_sq : ∀ k, Brownian.Ito.energy P T (fun ω s => Y k s ω) ≠ ⊤
  /-- Each coordinate of `Z` is predictable. -/
  Z_pred : ∀ k j, Probability.Predictable ℱ fun ω s => Z k s ω j
  /-- `Z` vanishes off the horizon. -/
  Z_vanish : ∀ k ω s, s ∉ Set.Icc (0 : ℝ) T → Z k s ω = 0
  /-- Each coordinate of `Z` has finite energy on the horizon. -/
  Z_sq : ∀ k j, Brownian.Ito.energy P T (fun ω s => Z k s ω j) ≠ ⊤
  /-- The drift process is jointly measurable. -/
  b_meas : ∀ i, Measurable (Function.uncurry (driftProc P T C X Y Z 0 i))
  /-- The drift process is progressively measurable. -/
  b_prog : ∀ i, Probability.ProgressivelyMeasurable ℱ (driftProc P T C X Y Z 0 i)
  /-- Almost every path of the drift process is integrable on the horizon. -/
  b_int : ∀ i, ∀ᵐ ω ∂P, IntegrableOn (driftProc P T C X Y Z 0 i ω) (Set.Icc (0 : ℝ) T)
  /-- The diffusion process is jointly measurable. -/
  σ_meas : ∀ i j,
    Measurable (Function.uncurry fun ω s => diffusionProc P T C X Y Z 0 i s ω j)
  /-- The diffusion process is progressively measurable. -/
  σ_prog : ∀ i j,
    Probability.ProgressivelyMeasurable ℱ fun ω s => diffusionProc P T C X Y Z 0 i s ω j
  /-- The diffusion process has finite energy on the horizon. -/
  σ_sq : ∀ i j,
    Brownian.Ito.energy P T (fun ω s => diffusionProc P T C X Y Z 0 i s ω j) ≠ ⊤
  /-- The driver process is jointly measurable. -/
  f_meas : ∀ k, Measurable (Function.uncurry (driverProc P T C X Y Z 0 k))
  /-- The driver process is progressively measurable. -/
  f_prog : ∀ k, Probability.ProgressivelyMeasurable ℱ (driverProc P T C X Y Z 0 k)
  /-- Almost every path of the driver process is integrable on the horizon. -/
  f_int : ∀ k, ∀ᵐ ω ∂P, IntegrableOn (driverProc P T C X Y Z 0 k ω) (Set.Icc (0 : ℝ) T)
  /-- Each coordinate of `X_T` is square integrable. -/
  XT_sq : ∀ i, MemLp (X i T) 2 P
  /-- The forward identity at every time of the horizon on one set of full measure, with a
  càdlàg version `M` of the Brownian integral. -/
  fwd : ∀ i, ∃ M : ℝ → Ω → ℝ,
    (∀ t ∈ Set.Icc (0 : ℝ) T, M t =ᵐ[P]
      Brownian.Multidim.MultidimBrownianMotion.stochasticIntegral W ℱ hℱW
        (diffusionProc P T C X Y Z 0 i) (σ_meas i) (σ_prog i)
        (sq_int_global_of_vanishing (fun ω _ hs => diffusionProc_of_notMem hs i ω) (σ_sq i)) t)
    ∧ (∀ᵐ ω ∂P, (∀ t ∈ Set.Ico (0 : ℝ) T, Tendsto (fun s => M s ω) (𝓝[>] t) (𝓝 (M t ω)))
      ∧ ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ L : ℝ, Tendsto (fun s => M s ω) (𝓝[<] t) (𝓝 L))
    ∧ ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T,
      X i t ω = ξ₀ i ω + (∫ s in Set.Icc (0 : ℝ) t, driftProc P T C X Y Z 0 i ω s) + M t ω
  /-- The backward identity at every time of the horizon on one set of full measure, with a
  càdlàg version `M` of the Brownian integral. -/
  bwd : ∀ k, ∃ M : ℝ → Ω → ℝ,
    (∀ t ∈ Set.Icc (0 : ℝ) T, M t =ᵐ[P]
      Brownian.Multidim.MultidimBrownianMotion.stochasticIntegral W ℱ hℱW (Z k)
        (fun j => Brownian.Ito.measurable_uncurry_of_predictable (Z_pred k j))
        (progressivelyMeasurable_of_predictable_of_vanish (Z_pred k) (Z_vanish k))
        (sq_int_global_of_vanishing (Z_vanish k) (Z_sq k)) t)
    ∧ (∀ᵐ ω ∂P, (∀ t ∈ Set.Ico (0 : ℝ) T, Tendsto (fun s => M s ω) (𝓝[>] t) (𝓝 (M t ω)))
      ∧ ∀ t ∈ Set.Ioc (0 : ℝ) T, ∃ L : ℝ, Tendsto (fun s => M s ω) (𝓝[<] t) (𝓝 L))
    ∧ ∀ᵐ ω ∂P, ∀ t ∈ Set.Icc (0 : ℝ) T,
      Y k t ω = terminalVal P T C X k ω + (∫ s in Set.Icc t T, driverProc P T C X Y Z 0 k ω s)
        - (M T ω - M t ω)

end Dissertation.WellPosedness.Spec
