/-!
# Example 5.5: the Riccati solution and the forward equation of the inert tuple

For `β₁, β₂ ≥ 0` and a horizon `T`, let `p(t) = a(β₁, β₂; T − t)`, with `a(c, α; ·)` the
solution of the scalar Riccati equation `a' = α − c a²`, `a(0) = 1`. Then `p` is positive on
`t ≤ T` and solves

`p' = β₁ p² − β₂`,   `p(T) = 1`.

Along the tuple `Y = p X`, `Z = p σ_c / (1 + β₁ p)`, `U = p h_c / (1 + β₁ p)`, the forward
coefficients `b = −β₁ y`, `σ = σ_c − β₁ z`, `h = h_c − β₁ u` of the dealer system of Example 5.5
of the well-posedness paper at `ε = 0` are `−β₁ p X`, `σ_c / (1 + β₁ p)` and `h_c / (1 + β₁ p)`,
since `1 − β₁ p / (1 + β₁ p) = 1 / (1 + β₁ p)`. The forward equation is therefore

`X_t = ξ₀ + ∫_0^t (−β₁ p(s) X_s) ds + ∫_0^t σ_c / (1 + β₁ p(s)) dW_s
  + ∫_0^t ∫_E h_c(e) / (1 + β₁ p(s)) Ñ(ds, de)`,   `t ∈ [0, T]`.

Writing `a = y / w₀` with `w₀' = c y`, the integrating factor `w(t) = w₀(T − t) / w₀(T)` satisfies
`w' = −β₁ p w`, `w(0) = 1`, and `w > 0`. By the product rule for a deterministic weight,
`X = w X̃` solves the forward equation, where

`X̃_t = ξ₀ + ∫_0^t σ_c / (w (1 + β₁ p)) dW_s + ∫_0^t ∫_E h_c(e) / (w (1 + β₁ p)) Ñ(ds, de)`

has deterministic integrands. The jump integrands are cut to `(0, T]` rather than `[0, T]`: this
changes them on a null set of times, and a deterministic marked process carried by `(0, T]` is
predictable for the marked predictable σ-algebra, generated by rectangles over times in `(r, q]`,
`r ≥ 0`.

## Main definitions

* `inertP` — the Riccati solution `p`.
* `inertW` — the integrating factor `w`.
* `inertGain` — the gain `p / (1 + β₁ p)`.
* `inertDrift`, `inertDiffusion`, `inertJump` — the integrands `−β₁ p X`, `σ_c / (1 + β₁ p)` and
  `h_c / (1 + β₁ p)` of the forward equation.
* `inertZ`, `inertU` — the integrands `Z = p σ_c / (1 + β₁ p)` and `U = p h_c / (1 + β₁ p)`.

## Main statements

* `inertP_self`, `inertP_pos`, `hasDerivAt_inertP` — `p(T) = 1`, `p > 0` on `t ≤ T`, and
  `p' = β₁ p² − β₂`.
* `eqOn_inertP_of_hasDerivWithinAt` — `p` is the only solution of `q' = β₁ q² − β₂` on `[0, T]`
  with `q(T) = 1`.
* `inertW_zero`, `inertW_pos`, `hasDerivAt_inertW` — `w(0) = 1`, `w > 0` and `w' = −β₁ p w`.
* `predictable_of_measurable_time`, `markedPredictable_indicator_Ioc_mul` — deterministic
  integrands are predictable, the marked ones when carried by `(0, T]`.
* `exists_linearFSDEJ_inert` — the forward equation has a solution.
-/

open MeasureTheory Filter Topology
open scoped ENNReal NNReal

namespace Dissertation.WellPosedness.Existence

open Dissertation.WellPosedness.BrownianPoisson Dissertation.WellPosedness.Stability
  Dissertation.WellPosedness.System LevyStochCalc Dissertation.WellPosedness

/-! ### The Riccati solution and the integrating factor -/

section Riccati

variable {β₁ β₂ T t : ℝ}

/-- The solution `p(t) = a(β₁, β₂; T − t)`, for `β₁, β₂ ≥ 0`, of the scalar Riccati equation
`p' = β₁ p² − β₂`, `p(T) = 1`, on `t ≤ T`, with `a(c, α; ·)` the solution of `a' = α − c a²`,
`a(0) = 1`. -/
noncomputable def inertP (β₁ β₂ T t : ℝ) : ℝ := Riccati.sol β₁ β₂ (T - t)

/-- The integrating factor `w(t) = w₀(T − t) / w₀(T)` of the forward equation, with
`w₀(u) = cosh(√(β₁ β₂) u) + β₁ shc(√(β₁ β₂), u)` the denominator of the Riccati solution
`a = y / w₀`: for `β₁, β₂ ≥ 0` and `T ≥ 0`, `w' = −β₁ p w` on `t ≤ T` and `w(0) = 1`. -/
noncomputable def inertW (β₁ β₂ T t : ℝ) : ℝ := Riccati.den β₁ β₂ (T - t) / Riccati.den β₁ β₂ T

/-- The terminal value `p(T) = 1`. -/
theorem inertP_self : inertP β₁ β₂ T T = 1 := by
  rw [inertP, sub_self, Riccati.sol_zero]

/-- **The Riccati solution is positive**: `p(t) > 0` for `t ≤ T`. -/
theorem inertP_pos (hβ₁ : 0 ≤ β₁) (hβ₂ : 0 ≤ β₂) (ht : t ≤ T) : 0 < inertP β₁ β₂ T t :=
  Riccati.sol_pos hβ₁ hβ₂ (sub_nonneg.2 ht)

/-- **The Riccati equation** `p'(t) = β₁ p(t)² − β₂` at every `t ≤ T`. -/
theorem hasDerivAt_inertP (hβ₁ : 0 ≤ β₁) (hβ₂ : 0 ≤ β₂) (ht : t ≤ T) :
    HasDerivAt (inertP β₁ β₂ T) (β₁ * inertP β₁ β₂ T t ^ 2 - β₂) t := by
  have h := (Riccati.hasDerivAt_sol hβ₁ hβ₂ (sub_nonneg.2 ht)).comp_const_sub T t
  refine h.congr_deriv ?_
  rw [inertP]
  ring

/-- The Riccati solution is continuous on `t ≤ T`. -/
theorem continuousOn_inertP (hβ₁ : 0 ≤ β₁) (hβ₂ : 0 ≤ β₂) :
    ContinuousOn (inertP β₁ β₂ T) (Set.Iic T) :=
  fun _ ht => (hasDerivAt_inertP hβ₁ hβ₂ ht).continuousAt.continuousWithinAt

/-- **The Riccati solution is unique**: a function `q` with `q' = β₁ q² − β₂` on `[0, T]`, the
derivative taken within `[0, T]`, and `q(T) = 1` is `p` on `[0, T]`. -/
theorem eqOn_inertP_of_hasDerivWithinAt (hβ₁ : 0 ≤ β₁) (hβ₂ : 0 ≤ β₂) {q : ℝ → ℝ}
    (hq : ∀ t ∈ Set.Icc (0 : ℝ) T, HasDerivWithinAt q (β₁ * q t ^ 2 - β₂) (Set.Icc 0 T) t)
    (hqT : q T = 1) : Set.EqOn q (inertP β₁ β₂ T) (Set.Icc 0 T) := by
  have hqc : ContinuousOn q (Set.Icc 0 T) := fun t ht => (hq t ht).continuousWithinAt
  have hpc : ContinuousOn (inertP β₁ β₂ T) (Set.Icc 0 T) :=
    (continuousOn_inertP hβ₁ hβ₂).mono fun _ ht => ht.2
  obtain ⟨Mq, hMq⟩ := isCompact_Icc.exists_bound_of_continuousOn hqc
  obtain ⟨Mp, hMp⟩ := isCompact_Icc.exists_bound_of_continuousOn hpc
  set M := max Mq Mp
  have hmem : ∀ f : ℝ → ℝ, (∀ t ∈ Set.Icc (0 : ℝ) T, ‖f t‖ ≤ M) →
      ∀ t ∈ Set.Ioc (0 : ℝ) T, f t ∈ Set.Icc (-M) M := fun f hf t ht =>
    abs_le.1 (hf t (Set.Ioc_subset_Icc_self ht))
  have hlip : ∀ t ∈ Set.Ioc (0 : ℝ) T, LipschitzOnWith (2 * β₁ * M).toNNReal
      (fun x : ℝ => β₁ * x ^ 2 - β₂) (Set.Icc (-M) M) := by
    intro _ _
    refine LipschitzOnWith.of_dist_le_mul fun x hx y hy => ?_
    rw [Real.dist_eq, Real.dist_eq, Real.coe_toNNReal _ (by
      have := (neg_le_self_iff.1 (hx.1.trans hx.2))
      positivity)]
    have hxy : |x + y| ≤ 2 * M := by
      rw [abs_le]; constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]
    calc |β₁ * x ^ 2 - β₂ - (β₁ * y ^ 2 - β₂)| = β₁ * (|x + y| * |x - y|) := by
          rw [← abs_mul, show β₁ * x ^ 2 - β₂ - (β₁ * y ^ 2 - β₂) = β₁ * ((x + y) * (x - y)) by
            ring, abs_mul, abs_of_nonneg hβ₁]
      _ ≤ β₁ * (2 * M * |x - y|) := by gcongr
      _ = 2 * β₁ * M * |x - y| := by ring
  have hderiv : ∀ f : ℝ → ℝ, (∀ t ∈ Set.Icc (0 : ℝ) T,
      HasDerivWithinAt f (β₁ * f t ^ 2 - β₂) (Set.Icc 0 T) t) →
      ∀ t ∈ Set.Ioc (0 : ℝ) T, HasDerivWithinAt f (β₁ * f t ^ 2 - β₂) (Set.Iic t) t :=
    fun f hf t ht => (hf t (Set.Ioc_subset_Icc_self ht)).mono_of_mem_nhdsWithin
      (mem_of_superset (Icc_mem_nhdsLE ht.1) (Set.Icc_subset_Icc le_rfl ht.2))
  have hp : ∀ t ∈ Set.Icc (0 : ℝ) T,
      HasDerivWithinAt (inertP β₁ β₂ T) (β₁ * inertP β₁ β₂ T t ^ 2 - β₂) (Set.Icc 0 T) t :=
    fun t ht => (hasDerivAt_inertP hβ₁ hβ₂ ht.2).hasDerivWithinAt
  exact ODE_solution_unique_of_mem_Icc_left (v := fun _ x => β₁ * x ^ 2 - β₂)
    (s := fun _ => Set.Icc (-M) M) hlip hqc (hderiv q hq)
    (hmem q fun t ht => (hMq t ht).trans (le_max_left _ _)) hpc (hderiv _ hp)
    (hmem _ fun t ht => (hMp t ht).trans (le_max_right _ _)) (hqT.trans inertP_self.symm)

/-- The Riccati solution is measurable. -/
theorem measurable_inertP : Measurable (inertP β₁ β₂ T) :=
  ((Riccati.contDiff_num (N := 0)).continuous.measurable.div
    (Riccati.contDiff_den (N := 0)).continuous.measurable).comp
    (measurable_const.sub measurable_id)

/-- `1 + β₁ p(t) > 0` for `t ≤ T`. -/
theorem one_add_mul_inertP_pos (hβ₁ : 0 ≤ β₁) (hβ₂ : 0 ≤ β₂) (ht : t ≤ T) :
    0 < 1 + β₁ * inertP β₁ β₂ T t := by
  have := mul_nonneg hβ₁ (inertP_pos hβ₁ hβ₂ ht).le
  linarith

/-- The integrating factor starts at `w(0) = 1`. -/
theorem inertW_zero (hβ₁ : 0 ≤ β₁) (hT : 0 ≤ T) : inertW β₁ β₂ T 0 = 1 := by
  rw [inertW, sub_zero, div_self (zero_lt_one.trans_le (Riccati.one_le_den hβ₁ hT)).ne']

/-- The integrating factor is positive: `w(t) > 0` for `t ≤ T`, when `T ≥ 0`. -/
theorem inertW_pos (hβ₁ : 0 ≤ β₁) (hT : 0 ≤ T) (ht : t ≤ T) : 0 < inertW β₁ β₂ T t :=
  div_pos (zero_lt_one.trans_le (Riccati.one_le_den hβ₁ (sub_nonneg.2 ht)))
    (zero_lt_one.trans_le (Riccati.one_le_den hβ₁ hT))

/-- **The integrating factor solves `w' = −β₁ p w`** at every `t ≤ T`. -/
theorem hasDerivAt_inertW (hβ₁ : 0 ≤ β₁) (hβ₂ : 0 ≤ β₂) (ht : t ≤ T) :
    HasDerivAt (inertW β₁ β₂ T) (-(β₁ * inertP β₁ β₂ T t * inertW β₁ β₂ T t)) t := by
  have h := ((Riccati.hasDerivAt_den hβ₁ hβ₂ (T - t)).comp_const_sub T t).div_const
    (Riccati.den β₁ β₂ T)
  refine h.congr_deriv ?_
  have hd : Riccati.den β₁ β₂ (T - t) ≠ 0 :=
    (zero_lt_one.trans_le (Riccati.one_le_den hβ₁ (sub_nonneg.2 ht))).ne'
  simp only [inertP, inertW, Riccati.sol]
  field_simp

/-- The integrating factor is continuous. -/
theorem continuous_inertW : Continuous (inertW β₁ β₂ T) :=
  ((Riccati.contDiff_den (N := 0)).continuous.comp
    (continuous_const.sub continuous_id)).div_const _

end Riccati

/-! ### Deterministic integrands -/

section Deterministic

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {E : Type*} [MeasurableSpace E] {ν : Measure E}
  {T : ℝ}

/-- A deterministic measurable process is predictable: the predictable σ-algebra contains the
sets `(r, ∞) × Ω`. -/
theorem predictable_of_measurable_time {ℱ : Filtration ℝ mΩ} {g : ℝ → ℝ} (hg : Measurable g) :
    Probability.Predictable ℱ fun (_ : Ω) s => g s := by
  letI : MeasurableSpace (ℝ × Ω) := Probability.predictableSigma ℱ
  have hfst : Measurable (Prod.fst : ℝ × Ω → ℝ) := measurable_of_Ioi fun x => by
    have hset : (Prod.fst : ℝ × Ω → ℝ) ⁻¹' Set.Ioi x = Set.Ioi x ×ˢ Set.univ := by
      ext p
      simp
    rw [hset]
    exact Probability.measurableSet_predictableSigma_Ioi_prod (@MeasurableSet.univ Ω (ℱ x))
  exact (hg.comp hfst).stronglyMeasurable

/-- **A deterministic marked process carried by `(0, T]` is predictable**: for `ν` σ-finite and
measurable `g` and `r`, `(s, e) ↦ 1_{(0, T]}(s) g(s) r(e)` is marked predictable, as the
pointwise limit of its restrictions to the spanning sets of `ν`. -/
theorem markedPredictable_indicator_Ioc_mul [SigmaFinite ν] {ℱ : Filtration ℝ mΩ} {g : ℝ → ℝ}
    (hg : Measurable g) {r : E → ℝ} (hr : Measurable r) :
    Probability.MarkedPredictable ℱ ν
      fun (_ : Ω) s e => (Set.Ioc (0 : ℝ) T).indicator g s * r e := by
  set f : ℕ → ℝ × E → ℝ := fun N p =>
    (Set.Ioc (0 : ℝ) T).indicator g p.1 * (spanningSets ν N).indicator r p.2 with hf
  have hfN : ∀ N, Probability.MarkedPredictable ℱ ν fun (_ : Ω) s e => f N (s, e) := fun N =>
    Probability.markedPredictable_of_measurable_window (measurableSet_spanningSets ν N)
      (measure_spanningSets_lt_top ν N).ne
      (((hg.indicator measurableSet_Ioc).comp measurable_fst).mul
        ((hr.indicator (measurableSet_spanningSets ν N)).comp measurable_snd))
      fun p hp => by
        simp only [hf]
        by_cases h1 : p.1 ∈ Set.Ioc (0 : ℝ) T
        · have h2 : p.2 ∉ spanningSets ν N := fun h2 => hp ⟨h1, h2⟩
          rw [Set.indicator_of_notMem h2, mul_zero]
        · rw [Set.indicator_of_notMem h1, zero_mul]
  refine @measurable_of_tendsto_metrizable _ _ (Probability.markedPredictableSigma ℱ ν) _ _ _ _
    (fun N p => f N (p.2.1, p.2.2)) _ hfN (tendsto_pi_nhds.2 fun p => ?_)
  refine tendsto_const_nhds.congr' ?_
  filter_upwards [eventually_ge_atTop (spanningSetsIndex ν p.2.2)] with N hN
  simp only [hf]
  rw [Set.indicator_of_mem (monotone_spanningSets ν hN (mem_spanningSetsIndex ν p.2.2))]

variable {P : Measure Ω}

omit [MeasurableSpace E] in
/-- A constant process has finite energy on `[0, T]` under a probability measure. -/
theorem energy_const_ne_top [IsProbabilityMeasure P] (c : ℝ) :
    Brownian.Ito.energy P T (fun (_ : Ω) (_ : ℝ) => c) ≠ ⊤ := by
  simp only [Brownian.Ito.energy, lintegral_const, measure_univ, mul_one,
    Measure.restrict_apply MeasurableSet.univ, Set.univ_inter]
  exact ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.coe_ne_top) measure_Icc_lt_top.ne

/-- A marked process depending on the mark alone, square integrable over the marks, has finite
marked energy on `[0, T]` under a probability measure. -/
theorem markedEnergy_mark_ne_top [IsProbabilityMeasure P] {r : E → ℝ}
    (hr : ∫⁻ e, (‖r e‖₊ : ℝ≥0∞) ^ 2 ∂ν ≠ ⊤) :
    Poisson.Compensated.markedEnergy P ν T (fun (_ : Ω) (_ : ℝ) e => r e) ≠ ⊤ := by
  simp only [Poisson.Compensated.markedEnergy, lintegral_const, measure_univ, mul_one,
    Measure.restrict_apply MeasurableSet.univ, Set.univ_inter]
  exact ENNReal.mul_ne_top hr measure_Icc_lt_top.ne

/-- A deterministic weight continuous on `[0, T]` and cut to a subset of `[0, T]` is bounded. -/
theorem exists_abs_indicator_le {S : Set ℝ} (hS : S ⊆ Set.Icc 0 T) {g : ℝ → ℝ}
    (hg : ContinuousOn g (Set.Icc 0 T)) : ∃ B, ∀ s, |S.indicator g s| ≤ B := by
  obtain ⟨B, hB⟩ := isCompact_Icc.exists_bound_of_continuousOn hg
  refine ⟨max B 0, fun s => ?_⟩
  by_cases hs : s ∈ S
  · rw [Set.indicator_of_mem hs, ← Real.norm_eq_abs]
    exact (hB s (hS hs)).trans (le_max_left _ _)
  · rw [Set.indicator_of_notMem hs, abs_zero]
    exact le_max_right _ _

variable {n : ℕ}

/-- A coordinate of a representative of `h ∈ L²(ν; ℝⁿ)` is measurable. -/
theorem measurable_coord_Lp (h : Lp (EuclideanSpace ℝ (Fin n)) 2 ν) (i : Fin n) :
    Measurable fun e => (h e).ofLp i :=
  (measurable_pi_apply i).comp ((WithLp.measurable_ofLp 2 _).comp
    (Lp.stronglyMeasurable h).measurable)

/-- A coordinate of a representative of `h ∈ L²(ν; ℝⁿ)` is square integrable. -/
theorem lintegral_coord_Lp_sq_ne_top (h : Lp (EuclideanSpace ℝ (Fin n)) 2 ν) (i : Fin n) :
    ∫⁻ e, (‖(h e).ofLp i‖₊ : ℝ≥0∞) ^ 2 ∂ν ≠ ⊤ := by
  have hle := sum_lintegral_le_enorm_sq (v := fun i e => (h e).ofLp i) (u := h)
    (ae_of_all _ fun e => WithLp.toLp_ofLp 2 (h e))
  refine ne_top_of_le_ne_top (ENNReal.pow_ne_top enorm_ne_top) (le_trans ?_ hle)
  exact Finset.single_le_sum (f := fun i => ∫⁻ e, (‖(h e).ofLp i‖₊ : ℝ≥0∞) ^ 2 ∂ν)
    (fun _ _ => zero_le) (Finset.mem_univ i)

end Deterministic

/-! ### The integrands -/

section Integrands

variable (Ω : Type*) {E : Type*} [MeasurableSpace E] {ν : Measure E} {n d : ℕ}

/-- The gain `p(t) / (1 + β₁ p(t))`. -/
noncomputable def inertGain (β₁ β₂ T t : ℝ) : ℝ :=
  inertP β₁ β₂ T t / (1 + β₁ * inertP β₁ β₂ T t)

/-- The gain `p / (1 + β₁ p)` is measurable. -/
theorem measurable_inertGain {β₁ β₂ T : ℝ} : Measurable (inertGain β₁ β₂ T) :=
  measurable_inertP.div (measurable_const.add (measurable_const.mul measurable_inertP))

/-- The diffusion of the forward equation, `σ_c / (1 + β₁ p(t))` on `[0, T]`, and `0` off it,
row by row. -/
noncomputable def inertDiffusion (β₁ β₂ T : ℝ) (σc : EuclideanSpace ℝ (Fin n × Fin d)) (i : Fin n)
    (t : ℝ) (_ω : Ω) (j : Fin d) : ℝ :=
  (Set.Icc (0 : ℝ) T).indicator (fun t => (1 + β₁ * inertP β₁ β₂ T t)⁻¹) t * σc.ofLp (i, j)

/-- The jump integrand of the forward equation, `h_c(e) / (1 + β₁ p(t))` on `(0, T]`, and `0`
off it, coordinate by coordinate. -/
noncomputable def inertJump (β₁ β₂ T : ℝ) (hc : Lp (EuclideanSpace ℝ (Fin n)) 2 ν) (i : Fin n)
    (t : ℝ) (_ω : Ω) (e : E) : ℝ :=
  (Set.Ioc (0 : ℝ) T).indicator (fun t => (1 + β₁ * inertP β₁ β₂ T t)⁻¹) t * (hc e).ofLp i

/-- The Brownian integrand `Z_t = p(t) σ_c / (1 + β₁ p(t))` on `[0, T]`, and `0` off it. -/
noncomputable def inertZ (β₁ β₂ T : ℝ) (σc : EuclideanSpace ℝ (Fin n × Fin d)) (k : Fin n)
    (t : ℝ) (_ω : Ω) (j : Fin d) : ℝ :=
  (Set.Icc (0 : ℝ) T).indicator (inertGain β₁ β₂ T) t * σc.ofLp (k, j)

/-- The jump integrand `U_t = p(t) h_c / (1 + β₁ p(t))` on `(0, T]`, and `0` off it. -/
noncomputable def inertU (β₁ β₂ T : ℝ) (hc : Lp (EuclideanSpace ℝ (Fin n)) 2 ν) (k : Fin n)
    (t : ℝ) (_ω : Ω) (e : E) : ℝ :=
  (Set.Ioc (0 : ℝ) T).indicator (inertGain β₁ β₂ T) t * (hc e).ofLp k

variable {Ω}

/-- The drift of the forward equation along `X`, `−β₁ p(t) X_t` on `[0, T]`, and `0` off it. -/
noncomputable def inertDrift (β₁ β₂ T : ℝ) (X : Fin n → ℝ → Ω → ℝ) (i : Fin n) (ω : Ω) (s : ℝ) :
    ℝ :=
  (Set.Icc (0 : ℝ) T).indicator (fun s => -(β₁ * inertP β₁ β₂ T s * X i s ω)) s

end Integrands

/-! ### The forward equation -/

universe u v w

section Forward

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E] {ν : Measure E}
  [SigmaFinite ν] {n d : ℕ} {P : Measure Ω} [IsProbabilityMeasure P]
  {D : LevyStochCalc.Driver.LevyDriver.{u, v, w} P d ν} {ℱ : Filtration ℝ ‹MeasurableSpace Ω›}
  {hℱW : ∀ j : Fin d, LevyStochCalc.Brownian.IsBrownianFiltration (D.W.W j) ℱ}
  {hℱN : LevyStochCalc.Poisson.IsPoissonFiltration D.N ℱ} {T β₁ β₂ : ℝ}
  {σc : EuclideanSpace ℝ (Fin n × Fin d)} {hc : Lp (EuclideanSpace ℝ (Fin n)) 2 ν}

/-- A solution of the linear forward equation is one for equal data. -/
theorem _root_.Dissertation.WellPosedness.Stability.LinearFSDEJ.of_eq {ξ₀ ξ₀' : Ω → ℝ}
    {b b' : Ω → ℝ → ℝ} {X X' : ℝ → Ω → ℝ} {σ σ' : ℝ → Ω → (Fin d → ℝ)} {γ γ' : ℝ → Ω → E → ℝ}
    (h : LinearFSDEJ D ℱ hℱW hℱN T ξ₀ b X σ γ) (hξ : ξ₀ = ξ₀') (hb : b = b') (hX : X = X')
    (hσ : σ = σ') (hγ : γ = γ') : LinearFSDEJ D ℱ hℱW hℱN T ξ₀' b' X' σ' γ' := by
  subst hξ hb hX hσ hγ
  exact h

/-- A solution of the linear backward equation is one for equal data. -/
theorem _root_.Dissertation.WellPosedness.BrownianPoisson.LinearBSDEJ.of_eq {ξ ξ' : Ω → ℝ}
    {φ φ' : Ω → ℝ → ℝ} {Y Y' : ℝ → Ω → ℝ} {Z Z' : ℝ → Ω → (Fin d → ℝ)} {U U' : ℝ → Ω → E → ℝ}
    (h : LinearBSDEJ D ℱ hℱW hℱN T ξ φ Y Z U) (hξ : ξ = ξ') (hφ : φ = φ') (hY : Y = Y')
    (hZ : Z = Z') (hU : U = U') : LinearBSDEJ D ℱ hℱW hℱN T ξ' φ' Y' Z' U' := by
  subst hξ hφ hY hZ hU
  exact h

/-- **The forward equation along the tuple has a solution.** Over a right-continuous filtration
carrying the driver, whose right-continuation is constant before `0` and whose time-`0` field
contains the null sets, for `β₁, β₂ ≥ 0`, `T ≥ 0` and a square-integrable `ℱ_0`-measurable `ξ₀`,
there is `X` with, coordinatewise,

`X_t = ξ₀ + ∫_0^t (−β₁ p(s) X_s) ds + ∫_0^t σ_c / (1 + β₁ p(s)) dW_s
  + ∫_0^t ∫_E h_c(e) / (1 + β₁ p(s)) Ñ(ds, de)`,   `t ∈ [0, T]`,

the jump integrand taken on `(0, T]`. -/
theorem exists_linearFSDEJ_inert [ℱ.IsRightContinuous]
    (hℱ0 : ∀ t : ℝ, t ≤ 0 → ℱ.rightCont 0 ≤ ℱ.rightCont t)
    (hnull : ∀ s : Set Ω, MeasurableSet s → P s = 0 → MeasurableSet[ℱ 0] s) (hβ₁ : 0 ≤ β₁)
    (hβ₂ : 0 ≤ β₂) (hT : 0 ≤ T) {ξ₀ : Fin n → Ω → ℝ} (hξ : ∀ i, MemLp (ξ₀ i) 2 P)
    (hξm : ∀ i, Measurable[ℱ 0] (ξ₀ i)) :
    ∃ X : Fin n → ℝ → Ω → ℝ, ∀ i, LinearFSDEJ D ℱ hℱW hℱN T (ξ₀ i) (inertDrift β₁ β₂ T X i)
      (X i) (inertDiffusion Ω β₁ β₂ T σc i) (inertJump Ω β₁ β₂ T hc i) := by
  set p := inertP β₁ β₂ T with hp
  set w := inertW β₁ β₂ T with hw
  set a : ℝ → ℝ := fun s => (w s * (1 + β₁ * p s))⁻¹ with ha
  have hpc : ContinuousOn p (Set.Icc 0 T) :=
    (continuousOn_inertP hβ₁ hβ₂).mono Set.Icc_subset_Iic_self
  have hden : ∀ s ∈ Set.Icc (0 : ℝ) T, w s * (1 + β₁ * p s) ≠ 0 := fun s hs =>
    (mul_pos (inertW_pos hβ₁ hT hs.2) (one_add_mul_inertP_pos hβ₁ hβ₂ hs.2)).ne'
  have hac : ContinuousOn a (Set.Icc 0 T) :=
    (continuous_inertW.continuousOn.mul (continuousOn_const.add
      (continuousOn_const.mul hpc))).inv₀ hden
  have ham : Measurable a :=
    (continuous_inertW.measurable.mul (measurable_const.add
      (measurable_const.mul measurable_inertP))).inv
  obtain ⟨B, hB⟩ := exists_abs_indicator_le subset_rfl hac
  obtain ⟨B', hB'⟩ := exists_abs_indicator_le Set.Ioc_subset_Icc_self hac
  choose X' hX' using fun i => exists_linearFSDEJ (D := D) (hℱW := hℱW) (hℱN := hℱN) hℱ0 hnull
    hT (hξ i) (hξm i) (b := fun _ _ => 0) measurable_const
    (Probability.progressivelyMeasurable_const ℱ 0) (fun _ _ _ => rfl)
    (by simp [Brownian.Ito.energy])
    (σ := fun s _ j => (Set.Icc (0 : ℝ) T).indicator a s * σc.ofLp (i, j))
    (fun j => ((ham.indicator measurableSet_Icc).comp measurable_snd).mul measurable_const)
    (fun j => progressivelyMeasurable_weight_mul (ham.indicator measurableSet_Icc)
      (Probability.progressivelyMeasurable_const ℱ (σc.ofLp (i, j))))
    (fun ω s hs => funext fun j => by simp [Set.indicator_of_notMem hs])
    (fun j => ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (energy_const_ne_top (σc.ofLp (i, j))))
      (energy_weight_mul_le hB (fun _ _ => σc.ofLp (i, j)) T))
    (γ := fun s _ e => (Set.Ioc (0 : ℝ) T).indicator a s * (hc e).ofLp i)
    (((ham.indicator measurableSet_Ioc).comp (measurable_fst.comp measurable_snd)).mul
      ((measurable_coord_Lp hc i).comp (measurable_snd.comp measurable_snd)))
    (markedPredictable_indicator_Ioc_mul (ν := ν) ham
      (measurable_coord_Lp hc i)).markedProgressivelyMeasurable
    (fun ω s e hs => by
      rw [Set.indicator_of_notMem (fun h => hs (Set.Ioc_subset_Icc_self h)), zero_mul])
    (ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (markedEnergy_mark_ne_top (lintegral_coord_Lp_sq_ne_top hc i)))
      (markedEnergy_weight_mul_le hB' (fun _ _ e => (hc e).ofLp i) T))
  refine ⟨fun i t ω => w (clampTime T t) * X' i t ω, fun i => ?_⟩
  have hq : ∀ t ∈ Set.Icc (0 : ℝ) T,
      HasDerivWithinAt w (-(β₁ * p t * w t)) (Set.Icc 0 T) t := fun t ht =>
    (hasDerivAt_inertW hβ₁ hβ₂ ht.2).hasDerivWithinAt
  have hq' : ContinuousOn (fun t => -(β₁ * p t * w t)) (Set.Icc 0 T) :=
    ((continuousOn_const.mul hpc).mul continuous_inertW.continuousOn).neg
  refine ((hX' i).mul_deterministic hT hq hq').of_eq ?_ ?_ rfl ?_ ?_
  · funext ω
    rw [hw, inertW_zero hβ₁ hT, one_mul]
  · funext ω s
    simp only [inertDrift]
    by_cases hs : s ∈ Set.Icc (0 : ℝ) T
    · rw [Set.indicator_of_mem hs, Set.indicator_of_mem hs, clampTime_of_mem hs]
      ring
    · rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem hs]
  · funext s ω j
    simp only [inertDiffusion]
    by_cases hs : s ∈ Set.Icc (0 : ℝ) T
    · rw [Set.indicator_of_mem hs, Set.indicator_of_mem hs, clampTime_of_mem hs, ha]
      have := hden s hs
      have hw0 : w s ≠ 0 := (inertW_pos hβ₁ hT hs.2).ne'
      field_simp
      rfl
    · rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem hs]
      ring
  · funext s ω e
    simp only [inertJump]
    by_cases hs : s ∈ Set.Ioc (0 : ℝ) T
    · have hs' := Set.Ioc_subset_Icc_self hs
      rw [Set.indicator_of_mem hs, Set.indicator_of_mem hs, clampTime_of_mem hs', ha]
      have := hden s hs'
      have hw0 : w s ≠ 0 := (inertW_pos hβ₁ hT hs'.2).ne'
      field_simp
      rfl
    · rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem hs]
      ring

end Forward

